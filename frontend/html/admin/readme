function doPost(e) {
  try {
    console.log('🎯 DEBUG: doPost started');

    let parameters = {};
    let contentType = '';

    // Handle different content types
    if (e.postData) {
      contentType = e.postData.type;

      if (contentType === 'application/x-www-form-urlencoded') {
        parameters = e.parameter;
        console.log('📝 Received FormData parameters');
      } else if (contentType === 'application/json') {
        parameters = JSON.parse(e.postData.contents);
        console.log('📝 Received JSON parameters');
      } else {
        parameters = e.parameter;
        console.log('📝 Received regular parameters');
      }
    } else {
      parameters = e.parameter;
      console.log('📝 Received parameter data');
    }

    if (!parameters || Object.keys(parameters).length === 0) {
      console.log('⚠️ No parameters received');
      return createCORSResponse({
        success: false,
        message: 'No parameters received'
      });
    }

    const action = parameters.action;
    console.log('🎯 DEBUG: Action received:', action);
    console.log('📊 Photo data length:', parameters.photo ? parameters.photo.length : 'No photo');

    let result;

    // Handle different actions
    if (action === 'student_registration') {
      const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
      const sheet = spreadsheet.getActiveSheet();
      const data = sheet.getDataRange().getValues();
      const headers = data[0];
      result = handleStudentRegistration(parameters, sheet, headers);
    }
    // In doPost function:
    else if (action === 'staff_registration') {
      result = handleStaffRegistration(parameters);
    }
    else if (action === 'completeTask') {
      result = completeTask(parameters);
    }
    else if (action === 'assignTask') {
      result = assignTask(parameters);
    }
    else if (action === 'addStaff') {
      result = addStaffMember(parameters);
    }
    else if (action === 'deleteStaff') {
      result = deleteStaff(parameters.staffId);
