// ==================== EMAIL FUNCTIONS FOR STAFF ====================

function resendApprovalEmail(data) {
  try {
    console.log('📧 Resending approval email for:', data.studentId);

    const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
    const studentSheet = spreadsheet.getSheets()[0];
    const allData = studentSheet.getDataRange().getValues();
    const headers = allData[0];

    let studentData = null;
    for (let i = 1; i < allData.length; i++) {
      if (allData[i][headers.indexOf('Unique ID')] === data.studentId) {
        studentData = {};
        headers.forEach((header, index) => {
          studentData[header] = allData[i][index];
        });
        break;
      }
    }

    if (!studentData) {
      return { success: false, message: 'Student not found' };
    }

    // Get ID Card Number and Project
    const idCardNumber = studentData['ID Card Number'] || 'Not Generated';
    const project = studentData.Project || 'Not Assigned';

    // Resend approval email using the existing function
    const emailSent = sendApprovalEmail(studentData, idCardNumber, project);

    return {
      success: true,
      message: 'Approval email resent successfully!',
      emailSent: emailSent
    };

  } catch (error) {
    console.error('❌ Error resending approval email:', error);
    return { success: false, message: 'Error: ' + error.toString() };
  }
}

function resendRejectionEmail(data) {
  try {
    console.log('📧 Resending rejection email for:', data.studentId);

    const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
    const studentSheet = spreadsheet.getSheets()[0];
    const allData = studentSheet.getDataRange().getValues();
    const headers = allData[0];

    let studentData = null;
    let rejectionReason = '';

    for (let i = 1; i < allData.length; i++) {
      if (allData[i][headers.indexOf('Unique ID')] === data.studentId) {
        studentData = {};
        headers.forEach((header, index) => {
          studentData[header] = allData[i][index];
        });
        rejectionReason = studentData['Rejection Reason'] || 'Not specified';
        break;
      }
    }

    if (!studentData) {
      return { success: false, message: 'Student not found' };
    }

    // Resend rejection email
    const emailSent = sendRejectionEmail(studentData, rejectionReason);

    return {
      success: true,
      message: 'Rejection email resent successfully!',
      emailSent: emailSent
    };

  } catch (error) {
    console.error('❌ Error resending rejection email:', error);
    return { success: false, message: 'Error: ' + error.toString() };
  }
}
// ==================== STUDENT DASHBOARD DATA FETCH ====================

function getStudentDashboardData(data) {
  try {
    console.log('🎓 Getting student dashboard data for:', data.email);

    const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
    const studentSheet = spreadsheet.getSheets()[0]; // Main student sheet
    const allData = studentSheet.getDataRange().getValues();
    const headers = allData[0];

    console.log('📊 Total students in sheet:', allData.length - 1);
    console.log('📋 Sheet headers:', headers);

    // Normalize the entered DOB
    const normalizedEnteredDOB = normalizeDateForComparison(data.dob);
    console.log('📅 Normalized entered DOB:', normalizedEnteredDOB);

    // Find student by email and date of birth
    for (let i = 1; i < allData.length; i++) {
      const row = allData[i];
      const studentEmail = row[headers.indexOf('Email')] || row[headers.indexOf('email')];
      const studentDOB = row[headers.indexOf('Date of Birth')] || row[headers.indexOf('DOB')] || row[headers.indexOf('dob')];

      console.log(`🔍 Checking row ${i}: ${studentEmail} - ${studentDOB}`);

      // Normalize stored DOB
      const normalizedStoredDOB = normalizeDateForComparison(studentDOB);

      if (studentEmail && studentEmail.toString().toLowerCase() === data.email.toLowerCase() &&
        normalizedStoredDOB === normalizedEnteredDOB) {

        console.log('✅ Student found for dashboard:', data.email);

        // Return complete student data for dashboard
        const studentData = {};
        headers.forEach((header, index) => {
          studentData[header] = row[index];
        });

        // Add calculated fields for dashboard
        const dashboardData = {
          // Personal Information
          name: studentData.Name || studentData.name || '',
          email: studentData.Email || studentData.email || '',
          phone: studentData.Phone || studentData.phone || '',
          dob: formatDisplayDate(studentData['Date of Birth'] || studentData.DOB || studentData.dob || ''),
          address: studentData.Address || studentData.address || studentData.Center || 'NEIPS SHILLONG',
          trade: studentData.Trade || studentData.trade || studentData.Course || '',

          // Application Status
          status: studentData.Status || studentData.status || 'Pending',
          uniqueId: studentData['Unique ID'] || studentData.uniqueId || '',
          timestamp: formatDisplayDate(studentData.Timestamp || studentData.timestamp || ''),

          // Approval Information
          project: studentData.Project || studentData.project || '',
          idCardNumber: studentData['ID Card Number'] || studentData.idCardNumber || '',
          approvalDate: formatDisplayDate(studentData['Approval Date'] || studentData.approvalDate || ''),

          // Additional Info
          center: studentData.Center || studentData.center || studentData.Address || 'NEIPS SHILLONG',
          photo: studentData.Photo || studentData.photo || ''
        };

        console.log('📊 Dashboard data prepared:', dashboardData);

        return {
          success: true,
          message: 'Student data retrieved successfully!',
          student: dashboardData
        };
      }
    }

    console.log('❌ Student not found for dashboard:', data.email);
    return {
      success: false,
      message: 'Student not found. Please check your email and date of birth.'
    };

  } catch (error) {
    console.error('❌ Error getting student dashboard data:', error);
    return {
      success: false,
      message: 'Error retrieving student data: ' + error.toString()
    };
  }
}

