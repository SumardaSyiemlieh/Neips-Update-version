function handleStudentLoginWithDashboard(data) {
  try {
    console.log('🔐 Handling student login with dashboard data:', data.email);

    // First verify login credentials
    const loginResult = handleStudentLogin(data);

    if (!loginResult.success) {
      return loginResult;
    }

    // If login successful, get complete dashboard data
    const dashboardResult = getStudentDashboardData(data);

    if (dashboardResult.success) {
      console.log('✅ Student login with dashboard data successful');
      return dashboardResult;
    } else {
      return {
        success: false,
        message: 'Login successful but could not load dashboard data.'
      };
    }

  } catch (error) {
    console.error('❌ Error in student login with dashboard:', error);
    return {
      success: false,
      message: 'Login failed: ' + error.toString()
    };
  }
}

