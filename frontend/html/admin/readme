// ==================== DEBUG ATTENDANCE SHEET ====================
function debugAttendanceSheet() {
  try {
    console.log('🔍 Debugging attendance sheet...');

    const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
    const attendanceSheet = spreadsheet.getSheetByName('Staff_Attendance');

    if (!attendanceSheet) {
      console.log('❌ Staff_Attendance sheet not found');
      return {
        success: false,
        message: 'Sheet not found'
      };
    }

    const allData = attendanceSheet.getDataRange().getValues();
    const headers = allData[0];

    console.log('📋 Headers:', headers);
    console.log('📊 Total rows:', allData.length);

    const today = new Date().toISOString().split('T')[0];
    console.log('📅 Today is:', today);

    // Show first 5 rows
    console.log('📝 First 5 rows:');
    for (let i = 1; i < Math.min(6, allData.length); i++) {
      console.log(`Row ${i}:`, allData[i]);
    }

    return {
      success: true,
      headers: headers,
      totalRows: allData.length,
      sampleData: allData.slice(1, 6)
    };

  } catch (error) {
    console.error('❌ Debug error:', error);
    return {
      success: false,
      error: error.toString()
    };
  }
}// ==================== UPDATE STAFF PROFILE (WITH PHOTO) ====================
// ==================== UPDATE STAFF PROFILE ====================
// ==================== STORE PROFILE PHOTO ====================
// ==================== STORE PROFILE PHOTO - FIXED ====================
function storeProfilePhoto(data) {
  try {
    console.log('📸 storeProfilePhoto called');
    console.log('📊 Received data type:', typeof data);
    console.log('📊 Full data object:', data);

    // Handle both direct object and e.parameter cases
    let staffId, staffName, photoData;

    if (typeof data === 'object') {
      // Check if data is an e.parameter object
      if (data.staffId !== undefined) {
        staffId = data.staffId;
        staffName = data.staffName;
        photoData = data.photoData;
      } else if (data.parameter && data.parameter.staffId) {
        // Handle e.parameter object
        staffId = data.parameter.staffId;
        staffName = data.parameter.staffName;
        photoData = data.parameter.photoData;
      } else {
        // Try to get values from keys
        staffId = data['staffId'] || data['staffid'] || data['StaffId'];
        staffName = data['staffName'] || data['staffname'] || data['StaffName'];
        photoData = data['photoData'] || data['photodata'] || data['PhotoData'];
      }
    } else {
      console.log('❌ Data is not an object:', data);
      return {
        success: false,
        message: 'Invalid data format'
      };
    }

    console.log('🔍 Extracted values:');
    console.log('  - Staff ID:', staffId);
    console.log('  - Staff Name:', staffName);
    console.log('  - Photo Data length:', photoData ? photoData.length : 'No photo data');

    if (!staffId) {
      return {
        success: false,
        message: 'Staff ID is required'
      };
    }

    const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
    let photoSheet = spreadsheet.getSheetByName('Staff_Photos');

    // Create photo sheet if it doesn't exist
    if (!photoSheet) {
      console.log('📄 Creating Staff_Photos sheet...');
      photoSheet = spreadsheet.insertSheet('Staff_Photos');
      const headers = ['StaffID', 'StaffName', 'PhotoData', 'UpdatedAt', 'PhotoSize'];
      photoSheet.getRange(1, 1, 1, headers.length).setValues([headers]);

      // Format header
      photoSheet.getRange(1, 1, 1, headers.length)
        .setBackground('#4a86e8')
        .setFontColor('white')
        .setFontWeight('bold');

      // Set column widths
      const widths = [100, 150, 300, 150, 100];
      for (let i = 0; i < widths.length; i++) {
        photoSheet.setColumnWidth(i + 1, widths[i]);
      }

      console.log('✅ Created Staff_Photos sheet');
    }

    const now = new Date();
    const photoSize = photoData ? photoData.length : 0;

    console.log('📊 Photo size:', photoSize, 'characters');

    // Check if staff already has a photo
    const allData = photoSheet.getDataRange().getValues();
    let existingRow = -1;

    console.log('🔍 Searching for existing photo in', allData.length, 'rows...');

    for (let i = 1; i < allData.length; i++) {
      const rowStaffId = allData[i][0]; // StaffID is in column A
      if (rowStaffId && rowStaffId.toString() === staffId.toString()) {
        existingRow = i;
        console.log('✅ Found existing photo at row:', i + 1);
        break;
      }
    }

    if (existingRow !== -1) {
      // Update existing photo
      const rowNumber = existingRow + 1;
      photoSheet.getRange(rowNumber, 2).setValue(staffName || '');
      photoSheet.getRange(rowNumber, 3).setValue(photoData || '');
      photoSheet.getRange(rowNumber, 4).setValue(now);
      photoSheet.getRange(rowNumber, 5).setValue(photoSize);
      console.log('✅ Updated existing profile photo at row', rowNumber);
    } else {
      // Add new photo
      const newRow = [
        staffId,
        staffName || '',
        photoData || '',
        now,
        photoSize
      ];
      photoSheet.appendRow(newRow);
      console.log('✅ Added new profile photo at row', photoSheet.getLastRow());
    }

    // Also update the main Staff sheet with photo reference
    updateMainStaffSheetWithPhotoReference(staffId, photoData);

    return {
      success: true,
      message: 'Profile photo stored successfully!',
      photoSize: photoSize,
      timestamp: now.toISOString()
    };

  } catch (error) {
    console.error('❌ Error storing profile photo:', error);
    console.error('❌ Error stack:', error.stack);
    return {
      success: false,
      message: 'Error: ' + error.toString()
    };
  }
}// ==================== UPDATE MAIN STAFF SHEET WITH PHOTO REFERENCE ====================
// ==================== UPDATE MAIN STAFF SHEET WITH PHOTO REFERENCE ====================
function updateMainStaffSheetWithPhotoReference(staffId, photoData) {
  try {
    console.log('📝 Updating main Staff sheet reference for:', staffId);

    const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
    const staffSheet = spreadsheet.getSheetByName('Staff');

    if (!staffSheet) {
      console.log('⚠️ Staff sheet not found');
      return false;
    }

    const allData = staffSheet.getDataRange().getValues();
    const headers = allData[0];

    console.log('📋 Staff sheet headers:', headers);
    console.log('📊 Total staff rows:', allData.length);

    // Try different column names for Staff ID
    const staffIdColumns = ['Staff ID', 'StaffID', 'ID', 'StaffId'];
    let staffIdIndex = -1;

    for (const colName of staffIdColumns) {
      const index = headers.indexOf(colName);
      if (index !== -1) {
        staffIdIndex = index;
        console.log('✅ Found Staff ID column:', colName, 'at index', index);
        break;
      }
    }

    if (staffIdIndex === -1) {
      console.log('❌ Could not find Staff ID column. Available columns:', headers);
      return false;
    }

    // Find staff row
    for (let i = 1; i < allData.length; i++) {
      const rowStaffId = allData[i][staffIdIndex];
      console.log(`🔍 Checking row ${i + 1}: ${rowStaffId}`);

      if (rowStaffId && rowStaffId.toString() === staffId.toString()) {
        const rowNumber = i + 1;
        console.log('✅ Found staff at row:', rowNumber);

        // Create a short reference instead of full photo data
        const photoRef = `PHOTO_${new Date().getTime()}`;

        // Try to find ProfilePhoto column
        const photoCol = headers.indexOf('ProfilePhoto');
        if (photoCol === -1) {
          // Add ProfilePhoto column at the end
          const lastCol = staffSheet.getLastColumn();
          staffSheet.getRange(1, lastCol + 1).setValue('ProfilePhoto');
          staffSheet.getRange(rowNumber, lastCol + 1).setValue(photoRef);
          console.log('✅ Added ProfilePhoto column at column', lastCol + 1);
        } else {
          staffSheet.getRange(rowNumber, photoCol + 1).setValue(photoRef);
          console.log('✅ Updated ProfilePhoto column at column', photoCol + 1);
        }

        // Also update Last Updated if column exists
        const lastUpdatedCol = headers.indexOf('Last Updated') || headers.indexOf('LastUpdated');
        if (lastUpdatedCol !== -1) {
          staffSheet.getRange(rowNumber, lastUpdatedCol + 1).setValue(new Date());
        }

        console.log('✅ Updated main Staff sheet with photo reference');
        return true;
      }
    }

    console.log('❌ Staff not found in main sheet with ID:', staffId);
    return false;

  } catch (error) {
    console.error('❌ Error updating main sheet:', error);
    return false;
  }
}// ==================== GET PROFILE PHOTO ====================
function getProfilePhoto(data) {
  try {
    console.log('🖼️ Getting profile photo for:', data.staffId);

    const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
    const photoSheet = spreadsheet.getSheetByName('Staff_Photos');

    if (!photoSheet) {
      return {
        success: true,
        photoData: '',
        message: 'No photo found'
      };
    }

    const allData = photoSheet.getDataRange().getValues();

    for (let i = 1; i < allData.length; i++) {
      if (allData[i][0] === data.staffId) {
        const photoData = allData[i][2] || '';

        return {
          success: true,
          photoData: photoData,
          photoSize: allData[i][4] || 0,
          lastUpdated: allData[i][3] || ''
        };
      }
    }

    return {
      success: true,
      photoData: '',
      message: 'No photo found for this staff member'
    };

  } catch (error) {
    console.error('❌ Error getting profile photo:', error);
    return {
      success: false,
      message: 'Error: ' + error.toString()
    };
  }
}

// ==================== ENHANCED UPDATE STAFF PROFILE ====================
function updateStaffProfile(data) {
  try {
    console.log('💾 updateStaffProfile called for:', data.staffId);

    const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
    const staffSheet = spreadsheet.getSheetByName('Staff');

    if (!staffSheet) {
      return {
        success: false,
        message: 'Staff sheet not found'
      };
    }

    const allData = staffSheet.getDataRange().getValues();
    const headers = allData[0];

    // Find staff by Staff ID or Email
    let staffRow = -1;
    for (let i = 1; i < allData.length; i++) {
      const staffIdInRow = allData[i][headers.indexOf('Staff ID')] ||
        allData[i][headers.indexOf('StaffID')];
      const emailInRow = allData[i][headers.indexOf('Email')];

      if ((staffIdInRow && staffIdInRow.toString() === data.staffId) ||
        (emailInRow && emailInRow.toString().toLowerCase() === data.email.toLowerCase())) {
        staffRow = i;
        break;
      }
    }

    if (staffRow === -1) {
      // Try to find by exact match in any ID field
      for (let i = 1; i < allData.length; i++) {
        for (let j = 0; j < headers.length; j++) {
          if (allData[i][j] && allData[i][j].toString() === data.staffId) {
            staffRow = i;
            break;
          }
        }
        if (staffRow !== -1) break;
      }
    }

    if (staffRow === -1) {
      return {
        success: false,
        message: 'Staff not found with ID: ' + data.staffId + ' or email: ' + data.email
      };
    }

    const rowNumber = staffRow + 1;
    console.log('✅ Found staff at row:', rowNumber);

    // Update fields
    const updates = [];

    // Map field names to column indices
    const fieldMap = {
      'Name': data.name,
      'Email': data.email,
      'Phone': data.phone,
      'Date of Birth': data.dob,
      'Gender': data.gender,
      'Address': data.address,
      'District': data.address // Also update District if it exists
    };

    for (const [header, value] of Object.entries(fieldMap)) {
      if (value !== undefined && value !== null) {
        const colIndex = headers.indexOf(header);
        if (colIndex !== -1) {
          staffSheet.getRange(rowNumber, colIndex + 1).setValue(value);
          updates.push(header);
        }
      }
    }

    // Update Last Updated timestamp
    const lastUpdatedCol = headers.indexOf('Last Updated') || headers.indexOf('LastUpdated');
    if (lastUpdatedCol !== -1) {
      staffSheet.getRange(rowNumber, lastUpdatedCol + 1).setValue(new Date());
      updates.push('Last Updated');
    }

    // Save changes
    SpreadsheetApp.flush();

    console.log('✅ Profile updated successfully. Updated fields:', updates);

    return {
      success: true,
      message: 'Profile updated successfully!',
      updatedFields: updates,
      staffId: data.staffId,
      timestamp: new Date().toISOString()
    };

  } catch (error) {
    console.error('❌ Error in updateStaffProfile:', error);
    return {
      success: false,
      message: 'Error: ' + error.toString(),
      stack: error.stack
    };
  }
}
