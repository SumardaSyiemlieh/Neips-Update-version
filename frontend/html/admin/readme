// ==================== UPDATE INITIALIZATION ====================
async function initializeApp() {
    // Add simplified center styles first
    addSimplifiedCenterStyles();

    // Populate centers dropdowns
    populateCentersDropdowns();

    // Populate courses dropdown
    populateCoursesDropdown();

    // Load dashboard stats
    await loadDashboardStats();

    // Load students table
    await loadStudentsTable();

    // Load staff table
    await loadStaffTable();

    // Load centers data with simplified display
    loadCentersData();

    // Set up event listeners
    setupEventListeners();

    // Show dashboard by default
    showSection('dashboard');

    // Add task management to admin
    addTaskManagementToAdmin();

    // Make dashboard stats clickable
    makeDashboardStatsClickable();

    // Initialize notifications
    initializeRealTimeNotifications();

    // Initialize batch approval system
    initializeBatchApproval();
}
