}
// ==================== STAFF REGISTRATION MANAGEMENT ====================
function getStaffRegistration(staffId) {
  try {
    console.log('🔍 Getting registration status for staff:', staffId);

    const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
    let staffSheet = spreadsheet.getSheetByName('Staff');

    if (!staffSheet) {
      return {
        success: false,
        message: 'Staff sheet not found',
        biometricRegistered: false,
        faceRegistered: false
      };
    }

    const allData = staffSheet.getDataRange().getValues();
    const headers = allData[0];

    // Find staff
    for (let i = 1; i < allData.length; i++) {
      const row = allData[i];
      const staffIdInRow = row[headers.indexOf('Staff ID')];

      if (staffIdInRow === staffId) {
        const biometricRegistered = row[headers.indexOf('BiometricRegistered')] === 'YES';
        const faceRegistered = row[headers.indexOf('FaceRegistered')] === 'YES';

        return {
          success: true,
          biometricRegistered: biometricRegistered,
          faceRegistered: faceRegistered
        };
      }
    }

    return {
      success: false,
      message: 'Staff not found',
      biometricRegistered: false,
      faceRegistered: false
    };

  } catch (error) {
    console.error('❌ Error getting staff registration:', error);
    return {
      success: false,
      message: 'Error: ' + error.toString(),
      biometricRegistered: false,
      faceRegistered: false
    };
  }
}

function updateStaffRegistration(data) {
  try {
    console.log('📝 Updating staff registration:', data.staffId);

    const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
    let staffSheet = spreadsheet.getSheetByName('Staff');

    if (!staffSheet) {
      return { success: false, message: 'Staff sheet not found' };
    }

    const allData = staffSheet.getDataRange().getValues();
    const headers = allData[0];

    // Find staff
    let staffRow = -1;
    for (let i = 1; i < allData.length; i++) {
      const row = allData[i];
      const staffIdInRow = row[headers.indexOf('Staff ID')];

      if (staffIdInRow === data.staffId) {
        staffRow = i;
        break;
      }
    }

    if (staffRow === -1) {
      return { success: false, message: 'Staff not found' };
    }

    const rowNumber = staffRow + 1;

    // Update biometric registration
    if (data.biometricRegistered) {
      const bioIndex = headers.indexOf('BiometricRegistered');
      if (bioIndex === -1) {
        // Add column if it doesn't exist
        const lastCol = staffSheet.getLastColumn();
        staffSheet.getRange(1, lastCol + 1).setValue('BiometricRegistered');
        staffSheet.getRange(rowNumber, lastCol + 1).setValue('YES');
      } else {
        staffSheet.getRange(rowNumber, bioIndex + 1).setValue('YES');
      }
    }

    // Update face registration
    if (data.faceRegistered) {
      const faceIndex = headers.indexOf('FaceRegistered');
      if (faceIndex === -1) {
        // Add column if it doesn't exist
        const lastCol = staffSheet.getLastColumn();
        staffSheet.getRange(1, lastCol + 1).setValue('FaceRegistered');
        staffSheet.getRange(rowNumber, lastCol + 1).setValue('YES');
      } else {
        staffSheet.getRange(rowNumber, faceIndex + 1).setValue('YES');
      }
    }

    // Update registration date
    const regDateIndex = headers.indexOf('RegistrationDate');
    const now = new Date();
    if (regDateIndex === -1) {
      const lastCol = staffSheet.getLastColumn();
      staffSheet.getRange(1, lastCol + 1).setValue('RegistrationDate');
      staffSheet.getRange(rowNumber, lastCol + 1).setValue(now);
    } else {
      staffSheet.getRange(rowNumber, regDateIndex + 1).setValue(now);
    }

    return {
      success: true,
      message: 'Staff registration updated successfully'
    };

  } catch (error) {
    console.error('❌ Error updating staff registration:', error);
    return {
      success: false,
      message: 'Error: ' + error.toString()
    };
  }
}
// ==================== REGISTER STAFF FACE ====================
// ==================== REGISTER STAFF FACE - FIXED VERSION ====================
function registerStaffFace(data) {
  try {
    console.log('📸 Registering face for:', data.staffId || data.email);

    const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
    let authSheet = spreadsheet.getSheetByName('Staff_Auth_Registry');

    // Create sheet if it doesn't exist
    if (!authSheet) {
      console.log('📄 Creating Staff_Auth_Registry sheet...');
      authSheet = createStaffAuthRegistrySheet();
    }

    const allData = authSheet.getDataRange().getValues();
    const headers = allData[0];

    const now = new Date();
    const today = now.toISOString().split('T')[0];

    // Find staff or create new entry
    let staffRow = -1;
    for (let i = 1; i < allData.length; i++) {
      const staffId = allData[i][headers.indexOf('StaffID')];
      const email = allData[i][headers.indexOf('Email')];

      if ((data.staffId && staffId === data.staffId) ||
        (data.email && email && email === data.email)) {
        staffRow = i;
        break;
      }
    }

    if (staffRow === -1) {
      // Create new entry
      const newRow = [
        data.staffId || 'STAFF' + (allData.length + 1).toString().padStart(3, '0'),
        data.name || '',
        data.email || '',
        data.phone || '',
        'YES', // FaceRegistered
        today, // FaceRegDate
        'NO',  // BiometricRegistered
        '',    // BioRegDate
        'face', // PreferredMethod
        'Active',
        today,
        'Face registered via staff portal'
      ];

      authSheet.appendRow(newRow);
      console.log('✅ Created new staff and registered face');
    } else {
      // Update existing entry
      const rowNumber = staffRow + 1;

      // Get column indices
      const faceRegIndex = headers.indexOf('FaceRegistered');
      const faceDateIndex = headers.indexOf('FaceRegDate');
      const preferredIndex = headers.indexOf('PreferredMethod');
      const lastUsedIndex = headers.indexOf('LastUsed');
      const notesIndex = headers.indexOf('Notes');

      // Update face registration
      if (faceRegIndex !== -1) authSheet.getRange(rowNumber, faceRegIndex + 1).setValue('YES');
      if (faceDateIndex !== -1) authSheet.getRange(rowNumber, faceDateIndex + 1).setValue(today);
      if (preferredIndex !== -1) authSheet.getRange(rowNumber, preferredIndex + 1).setValue('face');
      if (lastUsedIndex !== -1) authSheet.getRange(rowNumber, lastUsedIndex + 1).setValue(today);
      if (notesIndex !== -1) authSheet.getRange(rowNumber, notesIndex + 1).setValue('Face updated on ' + today);

      console.log('✅ Updated existing staff face registration');
    }

    // Also update the main Staff sheet
    updateStaffAuthStatusInMainSheet(data.staffId || data.email, 'face', today);

    return {
      success: true,
      message: 'Face registration successful!',
      staffId: data.staffId || 'N/A',
      registered: true,
      date: today,
      method: 'face'
    };

  } catch (error) {
    console.error('❌ Face registration error:', error);
    return {
      success: false,
      message: 'Error: ' + error.toString(),
      stack: error.stack
    };
  }
}

