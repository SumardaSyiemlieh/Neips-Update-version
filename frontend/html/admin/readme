// ==================== HELPER FUNCTION FOR TASK RESPONSES ====================
function handleTaskResponse(result, callback) {
  try {
    const jsonString = JSON.stringify(result);

    console.log('📤 Creating Task Response:', {
      hasCallback: !!callback,
      dataSuccess: result.success,
      dataType: typeof result
    });

    // Handle JSONP callback
    if (callback) {
      const jsonpResponse = `${callback}(${jsonString})`;
      console.log('📤 Sending JSONP response for task action');
      return ContentService.createTextOutput(jsonpResponse)
        .setMimeType(ContentService.MimeType.JAVASCRIPT);
    }

    // Regular JSON response
    console.log('📤 Sending JSON response for task action');
    return ContentService.createTextOutput(jsonString)
      .setMimeType(ContentService.MimeType.JSON);

  } catch (error) {
    console.error('❌ Error in handleTaskResponse:', error);
    const errorResponse = JSON.stringify({
      success: false,
      message: 'Response error: ' + error.toString()
    });
    return ContentService.createTextOutput(errorResponse)
      .setMimeType(ContentService.MimeType.JSON);
  }
}
// Enhanced CORS response function
function createCORSResponse(data) {
  const response = ContentService.createTextOutput(JSON.stringify(data))
    .setMimeType(ContentService.MimeType.JSON)
    .setHeaders({
      'Access-Control-Allow-Origin': '*',
      'Access-Control-Allow-Methods': 'GET, POST, OPTIONS, PUT, DELETE',
      'Access-Control-Allow-Headers': 'Content-Type, Access-Control-Allow-Headers, Authorization, X-Requested-With',
      'Access-Control-Max-Age': '86400'
    });

  return response;
}// ==================== STUDENT REGISTRATION (with photo) - UPDATED ====================
function handleStudentRegistration(data, sheet, headers) {
  try {
    console.log('🎯 DEBUG: handleStudentRegistration started');
    console.log('📝 Received data with photo length:', data.photo ? data.photo.length : 'No photo');
    console.log('📋 Sheet headers:', headers);

    // Validate required fields
    const requiredFields = ['name', 'email', 'phone', 'trade', 'address'];
    const missingFields = requiredFields.filter(field => !data[field]);

    if (missingFields.length > 0) {
      console.log('❌ Missing fields:', missingFields);
      return {
        success: false,
        message: 'Missing required fields: ' + missingFields.join(', ')
      };
    }

    // Check if email already exists
    console.log('🔍 Checking for duplicate email:', data.email);
    const allData = sheet.getDataRange().getValues();
    for (let i = 1; i < allData.length; i++) {
      const studentEmail = allData[i][headers.indexOf('Email')];
      if (studentEmail && studentEmail.toString().toLowerCase() === data.email.toLowerCase()) {
        console.log('❌ Duplicate email found');
        return {
          success: false,
          message: 'Email already registered. Please use a different email.'
        };
      }
    }

    const timestamp = new Date();
    const uniqueId = 'NEIPS' + Math.random().toString(36).substr(2, 9).toUpperCase();

    console.log('🆕 Generated Student ID:', uniqueId);

    // Prepare row data
    const rowData = [];
    for (let i = 0; i < headers.length; i++) {
      rowData[i] = '';
    }

    // Map data to columns
    headers.forEach((header, index) => {
      switch (header) {
        case 'Timestamp':
          rowData[index] = timestamp.toISOString();
          break;
        case 'Name':
          rowData[index] = data.name || '';
          break;
        case 'Email':
          rowData[index] = data.email || '';
          break;
        case 'Phone':
          rowData[index] = data.phone || '';
          break;
        case 'Trade':
          rowData[index] = data.trade || '';
          break;
        case 'Status':
          rowData[index] = 'Pending';
          break;
        case 'Unique ID':
          rowData[index] = uniqueId;
          break;
        case 'Date of Birth':
          rowData[index] = data.dob || '';
          break;
        case 'Address':
          rowData[index] = data.address || '';
          break;
        case 'Photo':
          // Store photo data (it will be truncated if too long, but that's okay)
          rowData[index] = data.photo || '';
          break;
        default:
          rowData[index] = '';
      }
    });

    console.log('📝 Appending row to sheet...');
    sheet.appendRow(rowData);

    console.log('✅ Student registration completed successfully!');

    return {
      success: true,
      message: 'Registration successful! Your application is pending approval.',
      studentId: uniqueId,
      timestamp: timestamp.toISOString()
    };

  } catch (error) {
    console.error('❌ Registration error:', error);
    return {
      success: false,
      message: 'Registration failed: ' + error.toString(),
      stack: error.stack
    };
  }
}
// ==================== STUDENT DATA RETRIEVAL ====================
function getAllStudents(data, headers) {
  try {
    const students = [];

    console.log('📊 Total data rows:', data.length);

    for (let i = 1; i < data.length; i++) {
      const studentObj = {};
      headers.forEach((header, index) => {
        studentObj[header] = data[i][index];
      });

      // Check photo data
      const photoData = studentObj.Photo || studentObj.photo;
      if (photoData && photoData.length > 0) {
        console.log(`📸 Student ${i}: ${studentObj.Name} - Photo exists (${photoData.length} chars)`);
      }

      students.push(studentObj);
    }

    const studentsWithPhotos = students.filter(s => {
      const photo = s.Photo || s.photo;
      return photo && photo.length > 100;
    });

    console.log('📊 Total students:', students.length);
    console.log('📸 Students with photos:', studentsWithPhotos.length);

    return createJSONResponse({
      success: true,
      students: students,
      total: students.length,
      studentsWithPhotos: studentsWithPhotos.length
    });

  } catch (error) {
    console.error('Error getting all students:', error);
    return createJSONResponse({
      success: false,
      message: 'Error: ' + error.toString()
    });
  }
}

function getStudentByEmail(email, data, headers) {
  try {
    console.log('🔍 Searching for email:', email);

    if (!email) {
      return createJSONResponse({
        success: false,
        message: 'Email parameter is required'
      });
    }

    for (let i = 1; i < data.length; i++) {
      const studentEmail = data[i][headers.indexOf('Email')] || data[i][headers.indexOf('email')];
      if (studentEmail && studentEmail.toString().toLowerCase() === email.toLowerCase()) {
        const studentObj = {};
        headers.forEach((header, index) => {
          studentObj[header] = data[i][index];
        });

        console.log('✅ Student found:', studentObj.Name);
        console.log('📸 Student photo exists:', !!(studentObj.Photo || studentObj.photo));

        return createJSONResponse({
          success: true,
          student: studentObj
        });
      }
    }

    return createJSONResponse({
      success: false,
      message: 'Student not found with email: ' + email
    });

  } catch (error) {
    console.error('Error getting student by email:', error);
    return createJSONResponse({
      success: false,
      message: 'Error: ' + error.toString()
    });
  }
}
function handleStudentLogin(data) {
  try {
    console.log('🔐 Handling student login:', data.email);

    const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
    const sheet = spreadsheet.getActiveSheet();
    const allData = sheet.getDataRange().getValues();
    const headers = allData[0];

    console.log('📊 Total students in sheet:', allData.length - 1);
    console.log('📋 Sheet headers:', headers);

    // Normalize the entered DOB
    const normalizedEnteredDOB = normalizeDateForComparison(data.dob);
    console.log('📅 Normalized entered DOB:', normalizedEnteredDOB);

    // Find student by email and date of birth
    for (let i = 1; i < allData.length; i++) {
      const row = allData[i];
      const studentEmail = row[headers.indexOf('Email')] || row[headers.indexOf('email')];
      const studentDOB = row[headers.indexOf('Date of Birth')] || row[headers.indexOf('DOB')] || row[headers.indexOf('dob')];

      console.log(`🔍 Checking row ${i}: ${studentEmail} - ${studentDOB}`);

      // Normalize stored DOB
      const normalizedStoredDOB = normalizeDateForComparison(studentDOB);

      if (studentEmail && studentEmail.toString().toLowerCase() === data.email.toLowerCase() &&
        normalizedStoredDOB === normalizedEnteredDOB) {

        console.log('✅ Login successful for:', data.email);

        // Return student data
        const studentData = {};
        headers.forEach((header, index) => {
          studentData[header] = row[index];
        });

        return {
          success: true,
          message: 'Login successful!',
          student: studentData
        };
      }
    }

    console.log('❌ Login failed for:', data.email);
    return {
      success: false,
      message: 'Invalid email or date of birth!'
    };

  } catch (error) {
    console.error('❌ Login error:', error);
    return {
      success: false,
      message: 'Login failed: ' + error.toString()
    };
  }
}

// ==================== DATE NORMALIZATION HELPER ====================
function normalizeDateForComparison(dateString) {
  if (!dateString) return '';

  try {
    // If it's already in simple YYYY-MM-DD format
    if (typeof dateString === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(dateString)) {
      return dateString;
    }

    // If it's a date string with time (UTC)
    if (typeof dateString === 'string' && dateString.includes('T')) {
      const date = new Date(dateString);
      return Utilities.formatDate(date, Session.getScriptTimeZone(), 'yyyy-MM-dd');
    }

    // Try to parse as date
    const date = new Date(dateString);
    if (!isNaN(date.getTime())) {
      return Utilities.formatDate(date, Session.getScriptTimeZone(), 'yyyy-MM-dd');
    }
  } catch (e) {
    console.error('Error normalizing date:', dateString, e);
  }

  return '';
}
function checkStudentLogin(email, dob, data, headers) {
  try {
    console.log('🔐 Checking login for:', email);

    // Normalize the entered DOB
    const normalizedEnteredDOB = normalizeDateForComparison(dob);

    for (let i = 1; i < data.length; i++) {
      const row = data[i];
      const studentEmail = row[headers.indexOf('Email')] || row[headers.indexOf('email')];
      const studentDOB = row[headers.indexOf('Date of Birth')] || row[headers.indexOf('DOB')] || row[headers.indexOf('dob')];

      // Normalize stored DOB
      const normalizedStoredDOB = normalizeDateForComparison(studentDOB);

      if (studentEmail && studentEmail.toString().toLowerCase() === email.toLowerCase() &&
        normalizedStoredDOB === normalizedEnteredDOB) {

        const studentData = {};
        headers.forEach((header, index) => {
          studentData[header] = row[index];
        });

        return createJSONResponse({
          success: true,
          student: studentData
        });
      }
    }

    return createJSONResponse({
      success: false,
      message: 'Invalid email or date of birth'
    });

  } catch (error) {
    console.error('Login check error:', error);
    return createJSONResponse({
      success: false,
      message: 'Error checking login: ' + error.toString()
    });
  }
}



// ==================== STUDENT APPROVAL FUNCTIONS ====================
function approveStudent(data) {
  try {
    console.log('✅ Approving student:', data.studentId);

    const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
    const sheet = spreadsheet.getActiveSheet();
    const allData = sheet.getDataRange().getValues();
    const headers = allData[0];

    // Find student row
    let studentRow = -1;
    let studentData = null;

    for (let i = 1; i < allData.length; i++) {
      const uniqueId = allData[i][headers.indexOf('Unique ID')];
      const email = allData[i][headers.indexOf('Email')];

      if (uniqueId === data.studentId || email === data.studentId) {
        studentRow = i;
        studentData = {};
        headers.forEach((header, index) => {
          studentData[header] = allData[i][index];
        });
        break;
      }
    }

    if (studentRow === -1) {
      return createJSONResponse({
        success: false,
        message: 'Student not found'
      });
    }

    const rowNumber = studentRow + 1;
    const timestamp = new Date();

    // Update status to Approved
    const statusIndex = headers.indexOf('Status');
    if (statusIndex !== -1) {
      sheet.getRange(rowNumber, statusIndex + 1).setValue('Approved');
    }

    // Assign Project if provided
    if (data.project) {
      const projectIndex = headers.indexOf('Project');
      if (projectIndex !== -1) {
        sheet.getRange(rowNumber, projectIndex + 1).setValue(data.project);
      }
    }

    // Generate ID Card Number starting with REQ
    const idCardNumber = 'REQ' + timestamp.getFullYear() +
      Math.random().toString(36).substr(2, 6).toUpperCase();

    // Update ID Card Number if column exists
    const idCardIndex = headers.indexOf('ID Card Number');
    if (idCardIndex !== -1) {
      sheet.getRange(rowNumber, idCardIndex + 1).setValue(idCardNumber);
    }

    // Set approval date
    const approvalDateIndex = headers.indexOf('Approval Date');
    if (approvalDateIndex !== -1) {
      sheet.getRange(rowNumber, approvalDateIndex + 1).setValue(timestamp);
    }

    console.log('✅ Student approved:', data.studentId);

    // Send approval email
    const emailSent = sendApprovalEmail(studentData, idCardNumber, data.project);

    return createJSONResponse({
      success: true,
      message: `Student approved successfully! ${data.project ? 'Assigned to ' + data.project + '.' : ''}`,
      idCardNumber: idCardNumber,
      project: data.project,
      emailSent: emailSent
    });

  } catch (error) {
    console.error('❌ Error approving student:', error);
    return createJSONResponse({
      success: false,
      message: 'Error approving student: ' + error.toString()
    });
  }
}

function rejectStudent(data) {
  try {
    console.log('❌ Rejecting student:', data.studentId);

    const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
    const sheet = spreadsheet.getActiveSheet();
    const allData = sheet.getDataRange().getValues();
    const headers = allData[0];

    // Find student row
    let studentRow = -1;
    let studentData = null;

    for (let i = 1; i < allData.length; i++) {
      const uniqueId = allData[i][headers.indexOf('Unique ID')];
      const email = allData[i][headers.indexOf('Email')];

      if (uniqueId === data.studentId || email === data.studentId) {
        studentRow = i;
        studentData = {};
        headers.forEach((header, index) => {
          studentData[header] = allData[i][index];
        });
        break;
      }
    }

    if (studentRow === -1) {
      return createJSONResponse({
        success: false,
        message: 'Student not found'
      });
    }

    const rowNumber = studentRow + 1;

    // Update status to Rejected
    const statusIndex = headers.indexOf('Status');
    if (statusIndex !== -1) {
      sheet.getRange(rowNumber, statusIndex + 1).setValue('Rejected');
    }

    // Add rejection reason if provided
    if (data.rejectionReason) {
      const rejectionIndex = headers.indexOf('Rejection Reason');
      if (rejectionIndex !== -1) {
        sheet.getRange(rowNumber, rejectionIndex + 1).setValue(data.rejectionReason);
      }
    }

    console.log('✅ Student rejected:', data.studentId);

    // Send rejection email
    sendRejectionEmail(studentData, data.rejectionReason);

    return createJSONResponse({
      success: true,
      message: 'Student rejected successfully! Notification email sent.'
    });

  } catch (error) {
    console.error('❌ Error rejecting student:', error);
    return createJSONResponse({
      success: false,
      message: 'Error rejecting student: ' + error.toString()
    });
  }
}
