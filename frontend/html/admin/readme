// ==================== GOOGLE SHEETS CONFIGURATION ====================
const GOOGLE_SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbzcDYjDCJJYWTHN9oaXO9kVLUkNe-wj7M-yNuJVfwjRA9BJDauCaEfP_pS54jaZ8uU/exec';

// ==================== FORM HANDLER INITIALIZATION ====================
