// ==================== LEAVE MANAGEMENT FUNCTIONS ====================

function getStaffLeave(staffId) {
  try {
    console.log('🏖️ Getting leave records for staff:', staffId);

    const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
    let leaveSheet = spreadsheet.getSheetByName('Staff_Leave');

    if (!leaveSheet) {
      console.log('📄 Creating new Staff_Leave sheet');
      leaveSheet = createLeaveSheet();
    }

    const allData = leaveSheet.getDataRange().getValues();
    const headers = allData[0];

    // Filter leave for this staff
    const staffLeave = [];
    const staffIdIndex = headers.indexOf('StaffID');

    if (staffIdIndex === -1) {
      return {
        success: true,
        leave: [],
        message: 'No leave records found'
      };
    }

    for (let i = 1; i < allData.length; i++) {
      const row = allData[i];
      if (row[staffIdIndex] === staffId) {
        const record = {};
        headers.forEach((header, index) => {
          record[header] = row[index];
        });
        staffLeave.push(record);
      }
    }

    console.log(`✅ Found ${staffLeave.length} leave records for ${staffId}`);

    return {
      success: true,
      leave: staffLeave,
      count: staffLeave.length
    };

  } catch (error) {
    console.error('❌ Error getting staff leave:', error);
    return {
      success: false,
      message: 'Error: ' + error.toString(),
      leave: [],
      count: 0
    };
  }
}

function applyStaffLeave(data) {
  try {
    console.log('📝 Applying leave for staff:', data.staffId);

    const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
    let leaveSheet = spreadsheet.getSheetByName('Staff_Leave');

    if (!leaveSheet) {
      console.log('📄 Creating new Staff_Leave sheet');
      leaveSheet = createLeaveSheet();
    }

    const now = new Date();
    const leaveId = 'LV-' + now.getTime().toString().substr(-6) + '-' + Math.random().toString(36).substr(2, 3).toUpperCase();

    // Calculate total days
    const fromDate = new Date(data.fromDate);
    const toDate = new Date(data.toDate);
    const diffTime = Math.abs(toDate - fromDate);
    const totalDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24)) + 1;

    const newLeave = [
      leaveId,
      data.staffId,
      data.staffName,
      data.fromDate,
      data.toDate,
      totalDays,
      data.leaveType,
      data.reason,
      now.toISOString().split('T')[0],
      'pending',
      '', // Approved By
      '', // Approval Date
      now.toISOString(),
      data.document || '',
      data.contact || ''
    ];

    leaveSheet.appendRow(newLeave);

    console.log('✅ Leave application submitted:', leaveId);

    return {
      success: true,
      message: 'Leave application submitted successfully!',
      leaveId: leaveId,
      totalDays: totalDays
    };

  } catch (error) {
    console.error('❌ Error applying leave:', error);
    return {
      success: false,
      message: 'Error: ' + error.toString()
    };
  }
}

function createLeaveSheet() {
  const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
  const leaveSheet = spreadsheet.insertSheet('Staff_Leave');

  // Create headers
  const headers = [
