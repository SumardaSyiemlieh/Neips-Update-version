function updateTaskSeenStatus(staffCenter, taskId) {
  try {
    const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
    let trackingSheet = spreadsheet.getSheetByName('TaskTracking');

    if (!trackingSheet) {
      trackingSheet = spreadsheet.insertSheet('TaskTracking');
      trackingSheet.getRange(1, 1, 1, 4).setValues([['Center', 'TaskID', 'LastSeen', 'NotificationSent']]);
    }

    const now = new Date();
    const data = trackingSheet.getDataRange().getValues();

    // Find existing entry
    let found = false;
    for (let i = 1; i < data.length; i++) {
      if (data[i][0] === staffCenter && data[i][1] === taskId) {
        trackingSheet.getRange(i + 1, 3).setValue(now);
        found = true;
        break;
      }
    }

    // Create new entry if not found
    if (!found) {
      trackingSheet.appendRow([staffCenter, taskId, now, 'YES']);
    }

    return { success: true };
  } catch (error) {
    console.error('Error updating task tracking:', error);
    return { success: false, message: error.toString() };
  }
}

function updateCompletionSeenStatus(taskId) {
  try {
    const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
    let completionTrackingSheet = spreadsheet.getSheetByName('CompletionTracking');

    if (!completionTrackingSheet) {
      completionTrackingSheet = spreadsheet.insertSheet('CompletionTracking');
      completionTrackingSheet.getRange(1, 1, 1, 3).setValues([['TaskID', 'CompletedSeen', 'SeenTime']]);
    }

    const now = new Date();
    const data = completionTrackingSheet.getDataRange().getValues();

    // Find existing entry
    let found = false;
    for (let i = 1; i < data.length; i++) {
      if (data[i][0] === taskId) {
        completionTrackingSheet.getRange(i + 1, 2).setValue('YES');
        completionTrackingSheet.getRange(i + 1, 3).setValue(now);
        found = true;
        break;
      }
    }

    // Create new entry if not found
    if (!found) {
      completionTrackingSheet.appendRow([taskId, 'YES', now]);
    }

    return { success: true };
  } catch (error) {
    console.error('Error updating completion tracking:', error);
    return { success: false, message: error.toString() };
  }
}

function getUnseenCompletions() {
  try {
    const tasksSheet = initializeTasksSheet();
    const allData = tasksSheet.getDataRange().getValues();
    const headers = allData[0];

    let completionTrackingSheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('CompletionTracking');
    if (!completionTrackingSheet) {
      return []; // No tracking sheet means all completions are unseen
    }

    const trackingData = completionTrackingSheet.getDataRange().getValues();
    const seenTaskIds = new Set();

    // Get all completed tasks admin has seen
    for (let i = 1; i < trackingData.length; i++) {
      if (trackingData[i][1] === 'YES') {
        seenTaskIds.add(trackingData[i][0]);
      }
    }

    // Find recently completed tasks that admin hasn't seen
    const unseenCompletions = [];
    for (let i = 1; i < allData.length; i++) {
      const taskStatus = allData[i][headers.indexOf('Status')];
      const taskId = allData[i][headers.indexOf('TaskID')];
      const completedDate = allData[i][headers.indexOf('CompletedDate')];

      if (taskStatus === 'Completed' && completedDate && !seenTaskIds.has(taskId)) {
        const task = {};
        headers.forEach((header, index) => {
          task[header] = allData[i][index];
        });
        unseenCompletions.push(task);
      }
    }

    return unseenCompletions;
  } catch (error) {
    console.error('Error getting unseen completions:', error);
    return [];
  }
}
