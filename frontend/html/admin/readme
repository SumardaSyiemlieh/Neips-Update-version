function getPendingStudents(data) {
  try {
    console.log('🔍 Getting pending students for center:', data.center);

    const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
    const studentSheet = spreadsheet.getSheets()[0]; // Sheet1
    const allData = studentSheet.getDataRange().getValues();
    const headers = allData[0];

    const pendingStudents = [];
    const statusIndex = headers.indexOf('Status');

    for (let i = 1; i < allData.length; i++) {
      const status = allData[i][statusIndex];
      if (status === 'Pending' || !status) {
        const studentObj = {};
        headers.forEach((header, index) => {
          studentObj[header] = allData[i][index];
        });
        pendingStudents.push(studentObj);
      }
    }

    console.log(`✅ Found ${pendingStudents.length} pending students`);

    return {
      success: true,
      students: pendingStudents,
      count: pendingStudents.length
    };

  } catch (error) {
    console.error('❌ Error getting pending students:', error);
    return {
      success: false,
      message: 'Error: ' + error.toString(),
      students: [],
      count: 0
    };
  }
}

