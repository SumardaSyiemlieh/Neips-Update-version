function getStaff() {
  try {
    console.log('👨‍💼 Getting staff data...');

    const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
    let staffSheet = spreadsheet.getSheetByName('Staff_Management');

    if (!staffSheet) {
      return {
        status: 'success',
        data: [],
        message: 'No staff data found'
      };
    }

    const data = staffSheet.getDataRange().getValues();

    if (data.length <= 1) {
      return {
        status: 'success',
        data: [],
        message: 'No staff members found'
      };
    }

    const headers = data[0];
    const staffMembers = [];

    for (let i = 1; i < data.length; i++) {
      const row = data[i];
      const staffMember = {};

      headers.forEach((header, index) => {
        staffMember[header.toLowerCase().replace(/ /g, '_')] = row[index];
      });

      staffMembers.push(staffMember);
    }

    console.log(`✅ Found ${staffMembers.length} staff members`);

    return {
      status: 'success',
      data: staffMembers,
      message: 'Staff data retrieved successfully'
    };

  } catch (error) {
    console.error('❌ Error getting staff:', error);
    return {
      status: 'error',
      data: [],
      message: 'Error retrieving staff data: ' + error.toString()
    };
  }
}
function getBatches() {
  try {
    console.log('📚 Getting batches from database...');

    var spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
    var sheet = spreadsheet.getSheetByName('Batches');

    if (!sheet) {
      console.log('❌ Batches sheet not found');
      return {
        success: false,
        message: 'Batches sheet not found',
        batches: []
      };
    }

    var data = sheet.getDataRange().getValues();
    var headers = data[0];
    var batches = [];

    console.log('📊 Found', data.length, 'rows in Batches sheet');
    console.log('📋 Headers:', headers);

    for (var i = 1; i < data.length; i++) {
      var row = data[i];
      var batch = {};
      for (var j = 0; j < headers.length; j++) {
        batch[headers[j]] = row[j];
      }
      batches.push(batch);
    }

    console.log('✅ Retrieved', batches.length, 'batches');

    return {
      success: true,
      batches: batches,
      message: 'Batches retrieved successfully'
    };

  } catch (error) {
    console.error('❌ Error retrieving batches: ' + error.toString());
    return {
      success: false,
      message: 'Error retrieving batches: ' + error.toString(),
      batches: []
    };
  }
}

function getTasksByCenter(centerName) {
  try {
    console.log('🔍 getTasksByCenter called for center:', centerName);

    var sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('Tasks');
    if (!sheet) {
      return {
        success: false,
        message: 'Tasks sheet not found'
      };
    }

    var data = sheet.getDataRange().getValues();
    var headers = data[0];

    console.log('📊 Headers found in Tasks sheet:', headers);
    console.log('🔍 Looking for center:', centerName);

    // Find column indices
    var centerCol = headers.indexOf('Center');
    var taskIdCol = headers.indexOf('TaskID');
    var titleCol = headers.indexOf('Title');
    var descCol = headers.indexOf('Description');
    var assignedToCol = headers.indexOf('AssignedTo');
    var assignedByCol = headers.indexOf('AssignedBy');
    var assignedDateCol = headers.indexOf('AssignedDate');
    var dueDateCol = headers.indexOf('DueDate');
    var statusCol = headers.indexOf('Status');
    var priorityCol = headers.indexOf('Priority');
    var completedDateCol = headers.indexOf('CompletedDate');
    var completionNotesCol = headers.indexOf('CompletionNotes');

    console.log('📍 Center column index:', centerCol);

    if (centerCol === -1) {
      return {
        success: false,
        message: 'Center column not found in Tasks sheet. Available columns: ' + headers.join(', ')
      };
    }

    var centerTasks = [];
    var now = new Date();

    for (var i = 1; i < data.length; i++) {
      var row = data[i];
      var taskCenter = row[centerCol];

      // Check if this task belongs to the requested center
      if (taskCenter && taskCenter.toString().toLowerCase().includes(centerName.toLowerCase())) {
        var dueDate = dueDateCol !== -1 && row[dueDateCol] ? new Date(row[dueDateCol]) : null;
        var isCompleted = statusCol !== -1 && (row[statusCol] === 'Completed' || row[statusCol] === 'completed');
        var isOverdue = !isCompleted && dueDate && dueDate < now;

        var task = {
          TaskID: taskIdCol !== -1 ? row[taskIdCol] : 'T' + i.toString().padStart(4, '0'),
          Title: titleCol !== -1 ? row[titleCol] : 'No Title',
          Description: descCol !== -1 ? row[descCol] : 'No Description',
          AssignedTo: assignedToCol !== -1 ? row[assignedToCol] : '',
          AssignedBy: assignedByCol !== -1 ? row[assignedByCol] : '',
          AssignedDate: assignedDateCol !== -1 ? row[assignedDateCol] : '',
          DueDate: dueDateCol !== -1 ? row[dueDateCol] : '',
          Status: statusCol !== -1 ? row[statusCol] : 'Pending',
          Priority: priorityCol !== -1 ? row[priorityCol] : 'Medium',
          Center: taskCenter,
          IsOverdue: isOverdue,
          DaysOverdue: isOverdue ? Math.ceil((now - dueDate) / (1000 * 60 * 60 * 24)) : 0
        };

        // Add completion details if available
        if (completedDateCol !== -1 && row[completedDateCol]) {
          task.CompletedDate = row[completedDateCol];
        }

        if (completionNotesCol !== -1 && row[completionNotesCol]) {
          task.CompletionNotes = row[completionNotesCol];
        }

        centerTasks.push(task);
        console.log('✅ Found task:', task.Title, 'for center:', taskCenter);
      }
    }

    console.log('📈 Total tasks found: ' + centerTasks.length + ' for center: ' + centerName);

    return {
      success: true,
      tasks: centerTasks,
      debug: {
        centerName: centerName,
        totalTasks: centerTasks.length,
        headers: headers
      }
    };

  } catch (error) {
    console.error('❌ Error in getTasksByCenter: ' + error.toString());
    return {
      success: false,
      message: 'Error: ' + error.toString(),
      stack: error.stack
    };
  }
}

function getMyBatchApprovals(center) {
  try {
    console.log('📋 Getting batch approvals for center:', center);

    const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
    let batchesSheet = spreadsheet.getSheetByName('Batches');

    if (!batchesSheet) {
      return {
        success: true,
        batches: [],
        message: 'No batches found for this center'
      };
    }

    const allData = batchesSheet.getDataRange().getValues();
    const headers = allData[0];

    const centerBatches = [];
    const centerIndex = headers.indexOf('Center');
    const batchIdIndex = headers.indexOf('BatchID');
    const statusIndex = headers.indexOf('Status');
    const approvalStatusIndex = headers.indexOf('ApprovalStatus');

    for (let i = 1; i < allData.length; i++) {
      const row = allData[i];
      const batchCenter = row[centerIndex];

      if (batchCenter && batchCenter.toString().toLowerCase().includes(center.toLowerCase())) {
        const batch = {};
        headers.forEach((header, index) => {
          batch[header] = row[index];
        });

        // Determine approval status
        let approvalStatus = 'draft';
        if (approvalStatusIndex !== -1 && row[approvalStatusIndex]) {
          approvalStatus = row[approvalStatusIndex].toString().toLowerCase();
        } else if (statusIndex !== -1 && row[statusIndex]) {
          const status = row[statusIndex].toString().toLowerCase();
          if (status.includes('pending') || status.includes('approval')) {
            approvalStatus = 'pending';
          } else if (status.includes('approved')) {
            approvalStatus = 'approved';
          } else if (status.includes('rejected')) {
            approvalStatus = 'rejected';
          }
        }

        batch.approval_status = approvalStatus;
        centerBatches.push(batch);
      }
    }

    console.log(`✅ Found ${centerBatches.length} batches for center: ${center}`);

    return {
      success: true,
      batches: centerBatches,
      count: centerBatches.length
    };

  } catch (error) {
    console.error('❌ Error getting batch approvals:', error);
    return {
      success: false,
      message: 'Error: ' + error.toString(),
      batches: [],
      count: 0
    };
  }
}

function updateTaskStatus(data) {
  try {
    console.log('🔄 Updating task status:', data.taskId, 'to:', data.status);

    const tasksSheet = initializeTasksSheet();
    const allData = tasksSheet.getDataRange().getValues();
    const headers = allData[0];

    // Find task row
    let taskRow = -1;
    for (let i = 1; i < allData.length; i++) {
      const taskIdInSheet = allData[i][headers.indexOf('TaskID')];
      if (taskIdInSheet === data.taskId) {
        taskRow = i;
        break;
      }
    }

    if (taskRow === -1) {
      return { success: false, message: 'Task not found' };
    }

    const rowNumber = taskRow + 1;
    const statusIndex = headers.indexOf('Status');

    if (statusIndex !== -1) {
      tasksSheet.getRange(rowNumber, statusIndex + 1).setValue(data.status);

      // If marking as completed, set completion date
      if (data.status.toLowerCase() === 'completed') {
        const completionIndex = headers.indexOf('CompletedDate');
        if (completionIndex !== -1) {
          tasksSheet.getRange(rowNumber, completionIndex + 1).setValue(new Date());
        }
      }

      SpreadsheetApp.flush();
      console.log('✅ Task status updated successfully');

      return {
        success: true,
        message: 'Task status updated successfully!'
      };
    } else {
      return { success: false, message: 'Status column not found' };
    }

  } catch (error) {
    console.error('❌ Error updating task status:', error);
    return { success: false, message: 'Error: ' + error.toString() };
  }
}
function updateStudentProject(data) {
  try {
    console.log('🔄 Updating student project:', data.studentId);

    const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
    const sheet = spreadsheet.getActiveSheet();
    const allData = sheet.getDataRange().getValues();
    const headers = allData[0];

    let studentRow = -1;
    for (let i = 1; i < allData.length; i++) {
      if (allData[i][headers.indexOf('Unique ID')] === data.studentId) {
        studentRow = i;
        break;
      }
    }

    if (studentRow === -1) {
      return createJSONResponse({
        success: false,
        message: 'Student not found'
      });
    }

    const rowNumber = studentRow + 1;
    sheet.getRange(rowNumber, headers.indexOf('Project') + 1).setValue(data.project);

    return createJSONResponse({
      success: true,
      message: 'Project updated successfully!'
    });

  } catch (error) {
    console.error('Error updating project:', error);
    return createJSONResponse({
      success: false,
      message: 'Error: ' + error.toString()
    });
  }
}

// ==================== EMAIL FUNCTIONS ====================
function sendApprovalEmail(studentData, idCardNumber, project) {
  try {
    const studentEmail = studentData.Email || studentData.email;
    const studentName = studentData.Name || studentData.name;
    const course = studentData.Trade || studentData.Course || studentData.trade || studentData.course;

    if (!studentEmail) {
      console.log('❌ No email found for student:', studentName);
      return false;
    }

    const subject = '🎉 NEIPS Application Approved - Your ID Card';
    const body = `
Dear ${studentName},

We are pleased to inform you that your application to NEIPS has been APPROVED!

✅ Your Student ID: ${idCardNumber}
📚 Course: ${course}
🏫 Center: ${studentData.Center || studentData.center || 'NEIPS Shillong'}
📋 Project: ${project || 'Not Assigned'}

Your admission has been confirmed. Please visit the institute to complete the admission process and collect your physical ID card.

Important Instructions:
1. Bring this email and original documents for verification
2. Carry 2 passport-size photographs
3. Complete fee payment (if pending)

Welcome to the NEIPS family! We look forward to helping you achieve your career goals.

Best regards,
NEIPS Administration Team
North Eastern Institute of Professional Studies
Nongstoin, Meghalaya

📞 Contact: +91 9330410244/03654796297
📧 Email: info@neips.in
    `;

    MailApp.sendEmail({
      to: studentEmail,
      subject: subject,
      body: body
    });

    console.log(`✅ Approval email sent to ${studentEmail}`);
    return true;

  } catch (error) {
    console.error('❌ Error sending approval email:', error);
    return false;
  }
}

function sendRejectionEmail(studentData, rejectionReason) {
  try {
    const studentEmail = studentData.Email || studentData.email;
    const studentName = studentData.Name || studentData.name;

    if (!studentEmail) {
      console.log('❌ No email found for student:', studentName);
      return false;
    }

    const subject = 'NEIPS Application Status Update';
    const body = `Dear ${studentName},

Thank you for your interest in NEIPS. After careful consideration, we regret to inform you that your application has not been approved.

${rejectionReason ? `Reason: ${rejectionReason}\n\n` : ''}
We encourage you to apply again in the future.

Best regards,
NEIPS Team, Nongstoin`;

    MailApp.sendEmail({
      to: studentEmail,
      subject: subject,
      body: body
    });

    console.log(`✅ Rejection email sent to ${studentEmail}`);
    return true;

  } catch (error) {
    console.error('❌ Error sending rejection email:', error);
    return false;
  }
}
// ==================== ADMIN CREDENTIALS FUNCTIONS ====================
function getAdminCredentials() {
  try {
    console.log('🔍 Getting admin credentials...');

    const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
    const adminSheet = spreadsheet.getSheetByName('AdminLogins');

    if (!adminSheet) {
      return {
        success: false,
        message: 'No admin credentials found'
      };
    }

    const adminData = adminSheet.getDataRange().getValues();

    if (adminData.length <= 1) {
      return {
        success: false,
        message: 'No admin credentials found'
      };
    }

    // Get the most recent admin entry (last row)
    const lastRow = adminData[adminData.length - 1];
    const headers = adminData[0];

    const admin = {
      email: lastRow[0],
      dob: lastRow[1],
      rememberMe: lastRow[2] === 'Yes'
    };

    console.log('✅ Found admin credentials:', admin.email);

    return {
      success: true,
      admin: admin
    };

  } catch (error) {
    console.error('❌ Error getting admin credentials:', error);
    return {
      success: false,
      message: 'Error getting admin credentials: ' + error.toString()
    };
  }
}

function saveAdminLogin(data) {
  try {
    console.log('💾 Saving admin login...');

    const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
    let adminSheet = spreadsheet.getSheetByName('AdminLogins');

    // If AdminLogins sheet doesn't exist, create it
    if (!adminSheet) {
      adminSheet = spreadsheet.insertSheet('AdminLogins');
      adminSheet.getRange('A1:F1').setValues([['Email', 'Date of Birth', 'Remember Me', 'Login Time', 'User Agent', 'Last Updated']]);
      console.log('✅ Created AdminLogins sheet');
    }

    // Check if admin already exists
    const adminData = adminSheet.getDataRange().getValues();
    const headers = adminData[0];
    let adminRow = -1;

    for (let i = 1; i < adminData.length; i++) {
      if (adminData[i][0] === data.email) {
        adminRow = i;
        break;
      }
    }

    const timestamp = new Date();

    if (adminRow !== -1) {
      // Update existing admin
      adminSheet.getRange(adminRow + 1, 2).setValue(data.dob);
      adminSheet.getRange(adminRow + 1, 3).setValue(data.rememberMe ? 'Yes' : 'No');
      adminSheet.getRange(adminRow + 1, 4).setValue(timestamp);
      adminSheet.getRange(adminRow + 1, 5).setValue(data.userAgent);
      adminSheet.getRange(adminRow + 1, 6).setValue(timestamp);
      console.log('✅ Updated existing admin login');
    } else {
      // Create new admin entry
      const newRow = [
        data.email,
        data.dob,
        data.rememberMe ? 'Yes' : 'No',
        timestamp,
        data.userAgent || '',
        timestamp
      ];
      adminSheet.appendRow(newRow);
      console.log('✅ Created new admin login entry');
    }

    return {
      success: true,
      message: 'Admin login saved successfully'
    };

  } catch (error) {
    console.error('❌ Error saving admin login:', error);
    return {
      success: false,
      message: 'Error saving admin login: ' + error.toString()
    };
  }
}
// ==================== ID CARD GENERATION ====================
function generateIDCard(data) {
  try {
    console.log('🪪 Generating ID Card for:', data.studentId);

    const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
    const sheet = spreadsheet.getActiveSheet();
    const allData = sheet.getDataRange().getValues();
    const headers = allData[0];

    // Find student
    let studentRow = -1;
    let studentData = null;

    for (let i = 1; i < allData.length; i++) {
      const uniqueId = allData[i][headers.indexOf('Unique ID')];
      const email = allData[i][headers.indexOf('Email')];

      if (uniqueId === data.studentId || email === data.studentId) {
        studentRow = i;
        studentData = {};
        headers.forEach((header, index) => {
          studentData[header] = allData[i][index];
        });
        break;
      }
    }

    if (studentRow === -1) {
      return createJSONResponse({
        success: false,
        message: 'Student not found'
      });
    }

    // Generate ID Card Number starting with REQ
    const timestamp = new Date();
    const idCardNumber = 'REQ' + timestamp.getFullYear() +
      Math.random().toString(36).substr(2, 6).toUpperCase();

    // Update ID Card Number in sheet
    const idCardIndex = headers.indexOf('ID Card Number');
    if (idCardIndex !== -1) {
      sheet.getRange(studentRow + 1, idCardIndex + 1).setValue(idCardNumber);
    }

    console.log('✅ ID Card generated:', idCardNumber);

    return createJSONResponse({
      success: true,
      message: 'ID Card generated successfully!',
      idCardNumber: idCardNumber
    });

  } catch (error) {
    console.error('❌ Error generating ID card:', error);
    return createJSONResponse({
      success: false,
      message: 'Error generating ID card: ' + error.toString()
    });
  }
}

// ==================== STAFF MANAGEMENT ====================
function addStaffMember(data) {
  try {
    console.log('👨‍💼 Adding staff member:', data.name);

    const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
    let staffSheet = spreadsheet.getSheetByName('Staff_Management');

    // Create Staff_Management sheet if it doesn't exist
    if (!staffSheet) {
      staffSheet = spreadsheet.insertSheet('Staff_Management');
      const headers = [
        'ID', 'Name', 'Email', 'Phone', 'Role', 'Center', 'Salary',
        'Address', 'Bank Name', 'Account Number', 'IFSC Code',
        'Account Holder', 'Join Date', 'Status'
      ];
      staffSheet.getRange(1, 1, 1, headers.length).setValues([headers]);
      console.log('✅ Created Staff_Management sheet');
    }

    // Generate staff ID
    const staffData = staffSheet.getDataRange().getValues();
    const staffId = 'STAFF' + (staffData.length).toString().padStart(3, '0');

    // Prepare staff data
    const newRow = [
      staffId,
      data.name,
      data.email,
      data.phone,
      data.role,
      data.center,
      data.salary,
      data.address || '',
      data.bank_name || '',
      data.bank_account_no || '',
      data.ifsc_code || '',
      data.account_holder || data.name,
      data.joining_date || new Date().toISOString().split('T')[0],
      'Active'
    ];

    staffSheet.appendRow(newRow);

    console.log('✅ Staff member added successfully:', staffId);

    return createJSONResponse({
      status: 'success',
      message: 'Staff member added successfully!',
      staffId: staffId
    });

  } catch (error) {
    console.error('❌ Error adding staff member:', error);
    return createJSONResponse({
      status: 'error',
      message: 'Error adding staff member: ' + error.toString()
    });
  }
}

function getStaffMembers() {
  try {
    console.log('🔍 Getting staff members...');

    const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
    let staffSheet = spreadsheet.getSheetByName('Staff_Management');

    if (!staffSheet) {
      console.log('❌ Staff_Management sheet not found');
      return createJSONResponse({
        status: 'success',
        data: [],
        message: 'No staff data found'
      });
    }

    const data = staffSheet.getDataRange().getValues();

    if (data.length <= 1) {
      return createJSONResponse({
        status: 'success',
        data: [],
        message: 'No staff members found'
      });
    }

    const headers = data[0];
    const staffMembers = [];

    for (let i = 1; i < data.length; i++) {
      const row = data[i];
      const staffMember = {};

      headers.forEach((header, index) => {
        staffMember[header.toLowerCase().replace(/ /g, '_')] = row[index];
      });

      staffMembers.push(staffMember);
    }

    console.log(`✅ Found ${staffMembers.length} staff members`);

    return createJSONResponse({
      status: 'success',
      data: staffMembers,
      message: 'Staff data retrieved successfully'
    });

  } catch (error) {
    console.error('❌ Error getting staff members:', error);
    return createJSONResponse({
      status: 'error',
      data: [],
      message: 'Error retrieving staff data: ' + error.toString()
    });
  }
}

// ==================== HELPER FUNCTIONS ====================
// FIXED: createJSONResponse function
function createJSONResponse(data, callback) {
  try {
    const jsonString = JSON.stringify(data);

    console.log('📤 Creating JSON Response:', {
      hasCallback: !!callback,
      dataSuccess: data.success,
      dataType: typeof data
    });

    // ✅ FIX: Handle JSONP callback
    if (callback) {
      const jsonpResponse = `${callback}(${jsonString})`;
      console.log('📤 Sending JSONP response');
      return ContentService.createTextOutput(jsonpResponse)
        .setMimeType(ContentService.MimeType.JAVASCRIPT);
    }

    // Regular JSON response
    console.log('📤 Sending JSON response');
    return ContentService.createTextOutput(jsonString)
      .setMimeType(ContentService.MimeType.JSON);

  } catch (error) {
    console.error('❌ Error in createJSONResponse:', error);
    const errorResponse = JSON.stringify({
      success: false,
      message: 'Response error: ' + error.toString()
    });
    return ContentService.createTextOutput(errorResponse)
      .setMimeType(ContentService.MimeType.JSON);
  }
}
function getRegistrationStudents(data, headers) {
  try {
    const students = [];

    for (let i = 1; i < data.length; i++) {
      const studentObj = {};
      headers.forEach((header, index) => {
        studentObj[header] = data[i][index];
      });
      students.push(studentObj);
    }

    return createJSONResponse({
      success: true,
      students: students,
      total: students.length
    });

  } catch (error) {
    console.error('Error getting registration students:', error);
    return createJSONResponse({
      success: false,
      message: 'Error: ' + error.toString()
    });
  }
}

function updateStudentStatus(data) {
  try {
    console.log('Updating student status:', data);

    const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
    const sheet = spreadsheet.getActiveSheet();
    const allData = sheet.getDataRange().getValues();
    const headers = allData[0];

    let studentRow = -1;
    for (let i = 1; i < allData.length; i++) {
      if (allData[i][headers.indexOf('Unique ID')] === data.studentId) {
        studentRow = i;
        break;
      }
    }

    if (studentRow === -1) {
      return createJSONResponse({
        success: false,
        message: 'Student not found'
      });
    }

    const rowNumber = studentRow + 1;

    if (data.status) {
      sheet.getRange(rowNumber, headers.indexOf('Status') + 1).setValue(data.status);
    }

    if (data.project) {
      sheet.getRange(rowNumber, headers.indexOf('Project') + 1).setValue(data.project);
    }

    if (data.rejectionReason) {
      sheet.getRange(rowNumber, headers.indexOf('Rejection Reason') + 1).setValue(data.rejectionReason);
    }

    if (data.status === 'Approved') {
      const approvalDate = new Date().toISOString();
      sheet.getRange(rowNumber, headers.indexOf('Approval Date') + 1).setValue(approvalDate);

      // Generate ID Card Number starting with REQ
      if (!data.idNumber) {
        const idCardNumber = 'REQ' + new Date().getFullYear() +
          Math.random().toString(36).substr(2, 6).toUpperCase();
        sheet.getRange(rowNumber, headers.indexOf('ID Card Number') + 1).setValue(idCardNumber);
      }
    }

    if (data.sendEmail) {
      const studentEmail = allData[studentRow][headers.indexOf('Email')];
      const studentName = allData[studentRow][headers.indexOf('Name')];
      const project = data.project || allData[studentRow][headers.indexOf('Project')];

      sendStatusEmail(studentEmail, studentName, data.status, data.rejectionReason, project);
    }

    return createJSONResponse({
      success: true,
      message: 'Student status updated successfully!'
    });

  } catch (error) {
    console.error('Error updating student:', error);
    return createJSONResponse({
      success: false,
      message: 'Error: ' + error.toString()
    });
  }
}

function sendStatusEmail(studentEmail, studentName, status, rejectionReason, project) {
  try {
    if (!studentEmail) return false;

    let subject, body;

    if (status === 'Approved') {
      subject = '🎉 NEIPS Application Approved';
      body = `Dear ${studentName},

Congratulations! Your application to NEIPS has been APPROVED.

${project ? `Project: ${project}\n` : ''}
Please visit the institute to complete your admission process.

Best regards,
NEIPS Team`;
    } else {
      subject = 'NEIPS Application Status Update';
      body = `Dear ${studentName},

After careful consideration, we regret to inform you that your application has not been approved.

${rejectionReason ? `Reason: ${rejectionReason}\n\n` : ''}
We encourage you to apply again in the future.

Best regards,
NEIPS Team`;
    }

    MailApp.sendEmail({
      to: studentEmail,
      subject: subject,
      body: body
    });

    return true;
  } catch (error) {
    console.error('Error sending status email:', error);
    return false;
  }
}
// ==================== DELETE STUDENT FUNCTION ====================
function deleteStudent(data) {
  try {
    console.log('🗑️ Deleting student:', data.studentId);

    const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
    const sheet = spreadsheet.getActiveSheet();
    const allData = sheet.getDataRange().getValues();
    const headers = allData[0];

    // Find student row
    let studentRow = -1;
    for (let i = 1; i < allData.length; i++) {
      const uniqueId = allData[i][headers.indexOf('Unique ID')];
      if (uniqueId === data.studentId) {
        studentRow = i;
        break;
      }
    }

    if (studentRow === -1) {
      return createJSONResponse({
        success: false,
        message: 'Student not found'
      });
    }

    // Delete the row (add 1 because sheet rows are 1-indexed)
    sheet.deleteRow(studentRow + 1);

    console.log('✅ Student deleted successfully:', data.studentId);

    return createJSONResponse({
      success: true,
      message: 'Student deleted successfully!'
    });

  } catch (error) {
    console.error('❌ Error deleting student:', error);
    return createJSONResponse({
      success: false,
      message: 'Error deleting student: ' + error.toString()
    });
  }
}



function deleteStaff(staffId) {
  try {
    console.log('🗑️ Deleting staff member:', staffId);

    const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
    let staffSheet = spreadsheet.getSheetByName('Staff_Management');

    if (!staffSheet) {
      throw new Error('Staff_Management sheet not found');
    }

    // Get all data
    const data = staffSheet.getDataRange().getValues();
    const headers = data[0];

    // Find the staff ID column
    const idColumn = headers.indexOf('ID');

    if (idColumn === -1) {
      throw new Error('Staff ID column not found');
    }

    // Find the row to delete
    let rowToDelete = -1;
    for (let i = 1; i < data.length; i++) {
      if (data[i][idColumn] === staffId) {
        rowToDelete = i + 1; // +1 because sheet rows are 1-indexed
        break;
      }
    }

    if (rowToDelete === -1) {
      return ContentService.createTextOutput(JSON.stringify({
        status: 'error',
        message: 'Staff member not found'
      })).setMimeType(ContentService.MimeType.JSON);
    }

    // Delete the row
    staffSheet.deleteRow(rowToDelete);

    console.log('✅ Staff member deleted successfully:', staffId);

    return ContentService.createTextOutput(JSON.stringify({
      status: 'success',
      message: 'Staff member deleted successfully'
    })).setMimeType(ContentService.MimeType.JSON);

  } catch (error) {
    console.error('❌ Error deleting staff:', error);
    return ContentService.createTextOutput(JSON.stringify({
      status: 'error',
      message: error.toString()
    })).setMimeType(ContentService.MimeType.JSON);
  }
}
// ==================== OFFER LETTER TRACKING ====================
function updateOfferLetterGenerated(staffId) {
  try {
    console.log('📝 Updating offer letter generation date for:', staffId);

    const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
    let staffSheet = spreadsheet.getSheetByName('Staff_Management');

    if (!staffSheet) {
      throw new Error('Staff_Management sheet not found');
    }

    // Get all data
    const data = staffSheet.getDataRange().getValues();
    const headers = data[0];

    // Find the staff ID column and last generated column
    const idColumn = headers.indexOf('ID');
    const lastGeneratedColumn = headers.indexOf('Last Generated');

    if (idColumn === -1) {
      throw new Error('Staff ID column not found');
    }

    // Find the row to update
    let rowToUpdate = -1;
    for (let i = 1; i < data.length; i++) {
      if (data[i][idColumn] === staffId) {
        rowToUpdate = i + 1; // +1 because sheet rows are 1-indexed
        break;
      }
    }

    if (rowToUpdate === -1) {
      throw new Error('Staff member not found');
    }

    const currentDate = new Date();

    // If Last Generated column doesn't exist, create it
    if (lastGeneratedColumn === -1) {
      // Add new column for Last Generated
      staffSheet.getRange(1, headers.length + 1).setValue('Last Generated');
      staffSheet.getRange(rowToUpdate, headers.length + 1).setValue(currentDate);
    } else {
      // Update existing Last Generated column
      staffSheet.getRange(rowToUpdate, lastGeneratedColumn + 1).setValue(currentDate);
    }

    console.log('✅ Offer letter generation date updated for:', staffId);
    return true;

  } catch (error) {
    console.error('❌ Error updating offer letter generation date:', error);
    return false;
  }
}
