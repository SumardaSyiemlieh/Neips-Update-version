function doGet(e) {
  try {
    console.log('🎯 DEBUG doGet STARTED');
    console.log('📊 Parameters received:', JSON.stringify(e.parameter));

    const action = e.parameter.action;
    const callback = e.parameter.callback;

    console.log('🔍 Action requested:', action);
    console.log('📞 Callback provided:', callback);

    let result;
    // ✨ ADD THIS CASE HERE:
    if (action === 'getAvailableTrades') {
      console.log('📊 Getting available trades for:', e.parameter.district);
      result = getAvailableTradesForDistrict(e.parameter.district);
    }
    // Handle student registration
    else if (action === 'student_registration') {
      console.log('📝 Handling student registration...');
      const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
      const sheet = spreadsheet.getActiveSheet();
      const data = sheet.getDataRange().getValues();
      const headers = data[0];
      result = handleStudentRegistration(e.parameter, sheet, headers);
    }
    // In your doGet function, add these cases:
    else if (action === 'getAdminCredentials') {
      result = getAdminCredentials();
    }
    else if (action === 'saveAdminLogin') {
      result = saveAdminLogin(e.parameter);
    }
    else if (action === 'studentLogin') {
      result = handleStudentLogin(e.parameter);
    }
    // In doGet function:
    else if (action === 'verifyStaffLogin') {
      console.log('📊 JSONP parameters received for verifyStaffLogin:', e.parameter);

      // Check if we have the right parameters
      if (!e.parameter.email || !e.parameter.dob) {
        result = {
          success: false,
          message: 'Missing email or date of birth',
          debug: { parameters: e.parameter }
        };
      } else {
        // Create the data object that verifyStaffLogin expects
        const loginData = {
          email: e.parameter.email,
          dob: e.parameter.dob
        };

        console.log('📧 Login data prepared:', loginData);
        result = verifyStaffLogin(loginData);
      }
    }
    else if (action === 'getCenterManagers') {
      result = getCenterManagers();
    }
    else if (action === 'verifyCenterManager') {
      result = verifyCenterManager(e.parameter);
    }
    else if (action === 'initializeCenterManagers') {
      result = initializeCenterManagers();
    }
    else if (action === 'getStudents') {
      result = getStudents();
    }
    // In doGet function:
    else if (action === 'staff_registration') {
      result = handleStaffRegistration(e.parameter);
    }

    else if (action === 'getStudentDashboard') {
      result = getStudentDashboardData(e.parameter);
    }
    else if (action === 'studentLoginWithDashboard') {
      result = handleStudentLoginWithDashboard(e.parameter);
    }
    else if (action === 'getStaff') {
      result = getStaff();
    }
    else if (action === 'getTasksByCenter') {
      result = getTasksByCenter(e.parameter.center);
    }
    else if (action === 'getBatches') {
      result = getBatches();
    }
    else if (action === 'getMyBatchApprovals') {
      result = getMyBatchApprovals(e.parameter.center);
    }
    else if (action === 'getAllTasks') {
      result = getAllTasks();
    }
    // In your doGet function, add this case:
    else if (action === 'getAvailableTrades') {
      result = getAvailableTradesForDistrict(e.parameter.district);
    }
    // In doGet function, add these cases:
    else if (action === 'getStaffAttendance') {
      result = getStaffAttendance(e.parameter.staffId);
    }
    else if (action === 'getStaffLeave') {
      result = getStaffLeave(e.parameter.staffId);
    }
    else if (action === 'register_face') {
      result = registerStaffFace(e.parameter);
    }
    else if (action === 'register_biometric') {
      result = registerStaffBiometric(e.parameter);
    }
    // ✅ ADD THIS LINE - get_auth_status for JSONP requests
    else if (action === 'get_auth_status') {
      console.log('🔍 Getting auth status for staff:', e.parameter.staffId);
      result = getAuthStatus(e.parameter.staffId);
    }
    else if (action === 'storeProfilePhoto') {
      console.log('📸 Handling storeProfilePhoto via GET');
      console.log('📊 Parameters:', e.parameter);
      result = storeProfilePhoto(e.parameter);
    }
    else if (action === 'getProfilePhoto') {
      result = getProfilePhoto(e.parameter);
    }
    else if (action === 'markStaffAttendance') {
      console.log('📊 JSONP parameters received for markStaffAttendance:', e.parameter);
      result = markStaffAttendance(e.parameter);
    }
    // Handle other actions you need
    else if (action === 'test') {
      result = {
        success: true,
        message: 'Test connection successful!',
        timestamp: new Date().toISOString()
      };
    }
    else {
      result = {
        success: false,
        message: 'Unknown action: ' + action
      };
    }


    console.log('📤 Sending response for JSONP');

    // Handle JSONP callback
    if (callback) {
      const jsonpResponse = `${callback}(${JSON.stringify(result)})`;
      console.log('📤 Sending JSONP response');
      return ContentService.createTextOutput(jsonpResponse)
        .setMimeType(ContentService.MimeType.JAVASCRIPT);
    }

    // Regular JSON response
    return ContentService.createTextOutput(JSON.stringify(result))
      .setMimeType(ContentService.MimeType.JSON)
      .setHeaders({
        'Access-Control-Allow-Origin': '*',
        'Access-Control-Allow-Methods': 'GET, POST, OPTIONS',
        'Access-Control-Allow-Headers': 'Content-Type'
      });

  } catch (error) {
    console.error('❌ Error in doGet:', error);

    if (e.parameter && e.parameter.callback) {
      const jsonpResponse = `${e.parameter.callback}(${JSON.stringify({
        success: false,
        message: 'Error: ' + error.toString()
      })})`;
      return ContentService.createTextOutput(jsonpResponse)
        .setMimeType(ContentService.MimeType.JAVASCRIPT);
    }

    return ContentService.createTextOutput(JSON.stringify({
      success: false,
      message: 'Error: ' + error.toString()
    }))
      .setMimeType(ContentService.MimeType.JSON)
      .setHeaders({
        'Access-Control-Allow-Origin': '*',
        'Access-Control-Allow-Methods': 'GET, POST, OPTIONS',
        'Access-Control-Allow-Headers': 'Content-Type'
      });
  }
}
