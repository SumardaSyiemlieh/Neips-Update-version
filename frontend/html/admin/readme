// ==================== TASK FUNCTIONS - SPECIFICALLY TARGET TASKS SHEET ====================

function getAllTasks() {
  try {
    const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
    const tasksSheet = spreadsheet.getSheetByName('Tasks'); // SPECIFICALLY TARGET TASKS SHEET

    if (!tasksSheet) {
      return {
        success: false,
        message: 'Tasks sheet not found',
        tasks: []
      };
    }

    const data = tasksSheet.getDataRange().getValues();
    const headers = data[0];

    const tasks = [];

    for (let i = 1; i < data.length; i++) {
      const task = {};
      headers.forEach((header, index) => {
        task[header] = data[i][index];
      });
      tasks.push(task);
    }

    return {
      success: true,
      tasks: tasks
    };

  } catch (error) {
    console.error('❌ Error getting all tasks:', error);
    return {
      success: false,
      message: 'Error: ' + error.toString(),
      tasks: []
    };
  }
}

function getCompletedTasksForAdmin() {
  try {
    console.log('🔔 ADMIN: Getting completed tasks from Tasks sheet...');

    const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
    const tasksSheet = spreadsheet.getSheetByName('Tasks'); // SPECIFICALLY TARGET TASKS SHEET

    if (!tasksSheet) {
      console.log('❌ Tasks sheet not found');
      return {
        success: false,
        message: 'Tasks sheet not found',
        completedTasks: [],
        count: 0
      };
    }

    console.log('✅ Found Tasks sheet:', tasksSheet.getName());

    const allData = tasksSheet.getDataRange().getValues();
    const headers = allData[0];

    console.log('📋 Headers in Tasks sheet:', headers);
    console.log('📊 Total rows in Tasks sheet:', allData.length);

    // Find column indices
    const statusIndex = headers.indexOf('Status');
    const taskIdIndex = headers.indexOf('TaskID');
    const titleIndex = headers.indexOf('Title');
    const descriptionIndex = headers.indexOf('Description');
    const centerIndex = headers.indexOf('Center');
    const priorityIndex = headers.indexOf('Priority');
    const completedDateIndex = headers.indexOf('CompletedDate');
    const notesIndex = headers.indexOf('CompletionNotes');

    console.log('📍 Column indices - Status:', statusIndex, 'TaskID:', taskIdIndex);

    if (statusIndex === -1) {
      console.log('❌ Status column not found in Tasks sheet');
      return {
        success: true,
        completedTasks: [],
        count: 0,
        debugInfo: 'Status column not found in Tasks sheet'
      };
    }

    const completedTasks = [];

    // Find all completed tasks
    for (let i = 1; i < allData.length; i++) {
      const row = allData[i];
      const status = row[statusIndex];

      if (status === 'Completed') {
        const task = {
          TaskID: taskIdIndex !== -1 ? row[taskIdIndex] : 'N/A',
          Title: titleIndex !== -1 ? row[titleIndex] : 'No Title',
          Description: descriptionIndex !== -1 ? row[descriptionIndex] : 'No Description',
          Center: centerIndex !== -1 ? row[centerIndex] : 'Unknown Center',
          Priority: priorityIndex !== -1 ? row[priorityIndex] : 'Medium',
          CompletedDate: completedDateIndex !== -1 ? row[completedDateIndex] : new Date().toISOString(),
          CompletionNotes: notesIndex !== -1 ? row[notesIndex] : 'No notes provided'
        };

        console.log('✅ FOUND COMPLETED TASK:', task.Title, '- Center:', task.Center);
        completedTasks.push(task);
      }
    }

    console.log(`🎯 TOTAL COMPLETED TASKS FOUND IN TASKS SHEET: ${completedTasks.length}`);

    return {
      success: true,
      completedTasks: completedTasks,
      count: completedTasks.length,
      debugInfo: {
        sheetName: tasksSheet.getName(),
        totalRows: allData.length,
        completedTasksFound: completedTasks.length,
        lastChecked: new Date().toISOString()
      }
    };

  } catch (error) {
    console.error('❌ Error in getCompletedTasksForAdmin:', error);
    return {
      success: false,
      message: 'Error: ' + error.toString(),
      completedTasks: [],
      count: 0
    };
  }
}

