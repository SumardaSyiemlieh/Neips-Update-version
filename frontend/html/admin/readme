// ==================== STAFF REGISTRATION FUNCTION ====================
// ==================== STAFF REGISTRATION FUNCTION ====================
function handleStaffRegistration(data) {
  try {
    console.log('👨‍💼 Staff registration started:', data.email);

    const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
    let staffSheet = spreadsheet.getSheetByName('Staff');

    // Create Staff sheet if it doesn't exist (using SIMPLE structure)
    if (!staffSheet) {
      console.log('📄 Creating Staff sheet...');
      staffSheet = createStaffSheet(); // Use the simple version
    }

    // Check if email already exists
    const allData = staffSheet.getDataRange().getValues();
    const headers = allData[0];

    for (let i = 1; i < allData.length; i++) {
      const staffEmail = allData[i][headers.indexOf('Email')];
      if (staffEmail && staffEmail.toString().toLowerCase() === data.email.toLowerCase()) {
        return {
          success: false,
          message: 'Email already registered. Please use a different email.'
        };
      }
    }

    // Generate staff ID
    const staffId = 'STAFF' + (allData.length).toString().padStart(4, '0');
    const timestamp = new Date();

    // Prepare row data for SIMPLE structure (9 columns)
    const rowData = [
      staffId,                    // Staff ID
      data.name || '',            // Name
      data.email || '',           // Email
      data.phone || '',           // Phone
      data.role || 'Staff',       // Member (was role)
      data.dob || '',             // Date of Birth
      data.address || '',         // District (was address)
      timestamp.toISOString().split('T')[0], // Created Date
      timestamp                   // Last Updated
    ];

    // Append to sheet
    staffSheet.appendRow(rowData);

    console.log('✅ Staff registered successfully:', staffId);

    return {
      success: true,
      message: 'Staff registration successful!',
      staffId: staffId,
      email: data.email
    };

  } catch (error) {
    console.error('❌ Staff registration error:', error);
    return {
      success: false,
      message: 'Registration failed: ' + error.toString()
    };
  }
}

// ==================== CREATE STAFF MANAGEMENT SHEET ====================
function createStaffSheet() {
  const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
  const staffSheet = spreadsheet.insertSheet('Staff');

  // Create comprehensive headers
  const headers = [
    'Staff ID',
    'Name',
    'Email',
    'Phone',
    'Member',
    'Date of Birth',
    'District',
    'Created Date',
    'Last Updated'
  ];

  staffSheet.getRange(1, 1, 1, headers.length).setValues([headers]);

  // Format header row
  staffSheet.getRange(1, 1, 1, headers.length)
    .setBackground('#4a86e8')
    .setFontColor('white')
    .setFontWeight('bold');

  // Set column widths
  const columnWidths = [100, 150, 200, 120, 120, 150, 100, 200, 150, 150, 100, 150, 120, 100, 120, 200, 100, 150, 80, 150, 150, 120, 120];

  for (let i = 0; i < columnWidths.length; i++) {
    staffSheet.setColumnWidth(i + 1, columnWidths[i]);
  }

  console.log('✅ Staff sheet created with headers');

  return staffSheet;
}
// ==================== STAFF LOGIN VERIFICATION ====================
// ==================== STAFF LOGIN VERIFICATION ====================
// ==================== STAFF LOGIN VERIFICATION ====================
function verifyStaffLogin(data) {
  try {
    console.log('🔐 VERIFY STAFF LOGIN CALLED');
    console.log('📊 Data type:', typeof data);
    console.log('📊 Full data object:', JSON.stringify(data));

    // Check if data is valid
    if (!data) {
      console.log('❌ Data is null or undefined');
      return {
        success: false,
        message: 'No login data provided',
        debug: { data: data }
      };
    }

    console.log('📧 Email from data:', data.email);
    console.log('📅 DOB from data:', data.dob);

    const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
    const staffSheet = spreadsheet.getSheetByName('Staff');

    if (!staffSheet) {
      console.log('❌ Staff sheet not found');
      return {
        success: false,
        message: 'Staff database not found'
      };
    }

    const allData = staffSheet.getDataRange().getValues();
    const headers = allData[0];

    console.log('📋 Headers in Staff sheet:', headers);
    console.log('📊 Total staff in sheet:', allData.length - 1);

    // Find ALL column indices FIRST
    const emailIndex = headers.indexOf('Email');
    const dobIndex = headers.indexOf('Date of Birth') || headers.indexOf('DOB') || headers.indexOf('dob');
    const nameIndex = headers.indexOf('Name');
    const staffIdIndex = headers.indexOf('Staff ID') || headers.indexOf('StaffID') || headers.indexOf('ID');
    const roleIndex = headers.indexOf('Role') || headers.indexOf('Member');
    const phoneIndex = headers.indexOf('Phone');
    const addressIndex = headers.indexOf('Address') || headers.indexOf('District');
    const profilePhotoIndex = headers.indexOf('ProfilePhoto');
    const genderIndex = headers.indexOf('Gender');
    const departmentIndex = headers.indexOf('Department');

    console.log('📍 Column indices found:');
    console.log('  - Email:', emailIndex);
    console.log('  - DOB:', dobIndex);
    console.log('  - Name:', nameIndex);
    console.log('  - Staff ID:', staffIdIndex);
    console.log('  - Role:', roleIndex);
    console.log('  - Phone:', phoneIndex);
    console.log('  - Address:', addressIndex);
    console.log('  - ProfilePhoto:', profilePhotoIndex);
    console.log('  - Gender:', genderIndex);
    console.log('  - Department:', departmentIndex);

    if (emailIndex === -1) {
      console.log('❌ Email column not found in Staff sheet');
      return {
        success: false,
        message: 'Staff sheet structure is incorrect.'
      };
    }

    // Normalize the entered DOB
    const normalizedEnteredDOB = normalizeDateForComparison(data.dob);
    console.log('📅 Normalized entered DOB:', normalizedEnteredDOB);

    // Find staff by email and date of birth
    for (let i = 1; i < allData.length; i++) {
      const row = allData[i];
      const staffEmail = row[emailIndex];
      const staffDOB = dobIndex !== -1 ? row[dobIndex] : '';

      console.log(`🔍 Checking row ${i}: ${staffEmail} - ${staffDOB}`);

      // Normalize stored DOB
      const normalizedStoredDOB = normalizeDateForComparison(staffDOB);

      if (staffEmail && staffEmail.toString().toLowerCase() === data.email.toLowerCase() &&
        normalizedStoredDOB === normalizedEnteredDOB) {

        console.log('✅ Staff login successful for:', data.email);

        // Return staff data with all available fields
        const staffData = {
          staffId: staffIdIndex !== -1 ? row[staffIdIndex] : `STAFF${i}`,
          name: nameIndex !== -1 ? row[nameIndex] : 'Staff Member',
          email: staffEmail,
          role: roleIndex !== -1 ? row[roleIndex] : 'Staff',
          dob: staffDOB,
          phone: phoneIndex !== -1 ? row[phoneIndex] : '',
          gender: genderIndex !== -1 ? row[genderIndex] : '',
          address: addressIndex !== -1 ? row[addressIndex] : '',
          department: departmentIndex !== -1 ? row[departmentIndex] : '',
          profilePhoto: profilePhotoIndex !== -1 ? row[profilePhotoIndex] : '',
          // Extract first and last name from full name
          firstName: nameIndex !== -1 ? (row[nameIndex] || '').split(' ')[0] : '',
          lastName: nameIndex !== -1 ? (row[nameIndex] || '').split(' ').slice(1).join(' ') : ''
        };

        console.log('📋 Staff data found:', {
          staffId: staffData.staffId,
          name: staffData.name,
          email: staffData.email,
          hasProfilePhoto: !!staffData.profilePhoto
        });

        return {
          success: true,
          message: 'Login successful!',
          staff: staffData
        };
      }
    }

    console.log('❌ Staff login failed for:', data.email);
    console.log('📊 Checked', allData.length - 1, 'staff records');

    return {
      success: false,
      message: 'Invalid email or date of birth!',
      debug: {
        emailSearched: data.email,
        dobSearched: data.dob
      }
    };

  } catch (error) {
    console.error('❌ Staff login error:', error);
    console.error('❌ Error stack:', error.stack);
    return {
      success: false,
      message: 'Login failed: ' + error.toString(),
      stack: error.stack
    };
  }
} function normalizeDateForComparison(dateString) {
  console.log('📅 DEBUG normalizeDateForComparison input:', dateString, 'Type:', typeof dateString);

  if (!dateString) {
    console.log('📅 DEBUG: Empty date string');
    return '';
  }

  try {
    // If it's already in simple YYYY-MM-DD format
    if (typeof dateString === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(dateString)) {
      console.log('📅 DEBUG: Already YYYY-MM-DD format');
      return dateString;
    }

    // If it's a date string with time (UTC)
    if (typeof dateString === 'string' && dateString.includes('T')) {
      const date = new Date(dateString);
      const result = Utilities.formatDate(date, Session.getScriptTimeZone(), 'yyyy-MM-dd');
      console.log('📅 DEBUG: Converted from ISO:', result);
      return result;
    }

    // Try to parse as date
    const date = new Date(dateString);
    if (!isNaN(date.getTime())) {
      const result = Utilities.formatDate(date, Session.getScriptTimeZone(), 'yyyy-MM-dd');
      console.log('📅 DEBUG: Parsed as Date:', result);
      return result;
    }

    console.log('📅 DEBUG: Could not parse date');
  } catch (e) {
    console.error('📅 DEBUG: Error normalizing date:', dateString, e);
  }

  return '';
}
// ==================== ATTENDANCE MANAGEMENT FUNCTIONS ====================

function getStaffAttendance(staffId) {
  try {
    console.log('📊 Getting attendance for staff:', staffId);

    const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
    let attendanceSheet = spreadsheet.getSheetByName('Staff_Attendance');

    if (!attendanceSheet) {
      console.log('📄 Creating new Staff_Attendance sheet');
      attendanceSheet = createAttendanceSheet();
    }

    const allData = attendanceSheet.getDataRange().getValues();
    const headers = allData[0];

    // Filter attendance for this staff
    const staffAttendance = [];
    const staffIdIndex = headers.indexOf('StaffID');

    if (staffIdIndex === -1) {
      return {
        success: true,
        attendance: [],
        message: 'No attendance records found'
      };
    }

    for (let i = 1; i < allData.length; i++) {
      const row = allData[i];
      if (row[staffIdIndex] === staffId) {
        const record = {};
        headers.forEach((header, index) => {
          // Format dates and times properly
          let value = row[index];

          // Format Date objects to readable strings
          if (value instanceof Date) {
            if (header === 'Date') {
              value = Utilities.formatDate(value, Session.getScriptTimeZone(), 'yyyy-MM-dd');
            } else if (header === 'CheckIn' || header === 'CheckOut') {
              value = Utilities.formatDate(value, Session.getScriptTimeZone(), 'HH:mm');
            }
          }

          record[header] = value;
        });
        staffAttendance.push(record);
      }
    }

    console.log(`✅ Found ${staffAttendance.length} attendance records for ${staffId}`);

    return {
      success: true,
      attendance: staffAttendance,
      count: staffAttendance.length
    };

  } catch (error) {
    console.error('❌ Error getting staff attendance:', error);
    return {
      success: false,
      message: 'Error: ' + error.toString(),
      attendance: [],
      count: 0
    };
  }
}// ==================== MARK STAFF ATTENDANCE - FIXED ====================
// ==================== MARK STAFF ATTENDANCE - FIXED ====================
// ==================== MARK STAFF ATTENDANCE - SINGLE ROW FIXED ====================
// ==================== MARK STAFF ATTENDANCE - FINAL FIX ====================
// ==================== MARK STAFF ATTENDANCE - FIXED VERSION ====================
// ==================== MARK STAFF ATTENDANCE - FIXED WITH LATE STATUS ====================
function markStaffAttendance(data) {
  try {
    console.log('⏱️ Marking attendance for staff:', data.staffId);
    console.log('🕒 Action:', data.attendanceAction || data.action);

    // Handle both parameter names
    const action = data.attendanceAction || data.action || 'check-in';
    const mode = data.mode || 'manual';

    if (!data.staffId) {
      return {
        success: false,
        message: 'Staff ID is required'
      };
    }

    const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
    let attendanceSheet = spreadsheet.getSheetByName('Staff_Attendance');

    // Create sheet if it doesn't exist
    if (!attendanceSheet) {
      console.log('📄 Creating new Staff_Attendance sheet');
      attendanceSheet = createAttendanceSheet();
    }

    const now = new Date();
    const todayISO = now.toISOString().split('T')[0];
    const todayDate = new Date(todayISO);

    // FIX 1: Get time in 12-hour format with AM/PM
    const timeString = formatTime12Hour(now);
    const time24Hour = now.getHours() + ':' + now.getMinutes().toString().padStart(2, '0');

    console.log('📅 Today:', todayISO);
    console.log('🕐 Time (12h):', timeString);
    console.log('🕐 Time (24h):', time24Hour);

    // Get existing data
    const allData = attendanceSheet.getDataRange().getValues();
    const headers = allData[0];

    // Find column indices
    const dateIndex = headers.indexOf('Date');
    const staffIdIndex = headers.indexOf('StaffID');
    const checkInIndex = headers.indexOf('CheckIn');
    const checkOutIndex = headers.indexOf('CheckOut');
    const statusIndex = headers.indexOf('Status');
    const methodIndex = headers.indexOf('Method');
    const remarksIndex = headers.indexOf('Remarks');
    const totalHoursIndex = headers.indexOf('TotalHours');
    const timestampIndex = headers.indexOf('Timestamp');
    const actionIndex = headers.indexOf('Action');

    // FIX 2: Determine status based on check-in time (only for check-in)
    let status = 'present';
    let remarks = '';

    // If checking in AFTER 10:30 AM, mark as late
    if (action === 'check-in') {
      const currentHour = now.getHours();
      const currentMinute = now.getMinutes();

      // Check if it's after 10:30 AM (10:30 = 10*60 + 30 = 630 minutes)
      const currentTotalMinutes = currentHour * 60 + currentMinute;
      const lateThreshold = 10 * 60 + 30; // 10:30 AM in minutes

      if (currentTotalMinutes > lateThreshold) {
        status = 'late';
        remarks = 'Arrived after 10:30 AM';
        console.log('⚠️ Marking as LATE (arrived after 10:30 AM)');
      }
    }

    // Check if there's already a record for today
    let existingRow = -1;
    let existingCheckIn = '';
    let existingCheckOut = '';

    for (let i = 1; i < allData.length; i++) {
      const row = allData[i];
      const rowDate = row[dateIndex];
      const rowStaffId = row[staffIdIndex];

      // Compare dates properly
      let isDateMatch = false;
      if (rowDate instanceof Date) {
        const rowDateStr = Utilities.formatDate(rowDate, Session.getScriptTimeZone(), 'yyyy-MM-dd');
        const todayStr = Utilities.formatDate(todayDate, Session.getScriptTimeZone(), 'yyyy-MM-dd');
        isDateMatch = rowDateStr === todayStr;
      } else if (typeof rowDate === 'string') {
        // Handle string dates
        const rowDateStr = rowDate.split('T')[0];
        isDateMatch = rowDateStr === todayISO;
      }

      if (isDateMatch && rowStaffId == data.staffId) {
        existingRow = i;
        existingCheckIn = row[checkInIndex];
        existingCheckOut = row[checkOutIndex];
        console.log('✅ Found existing record');
        console.log('   CheckIn:', existingCheckIn);
        console.log('   CheckOut:', existingCheckOut);
        break;
      }
    }

    let responseMessage = '';

    if (existingRow > -1) {
      // Update existing record
      const rowNumber = existingRow + 1;

      if (action === 'check-in') {
        // Check if check-in already exists
        if (existingCheckIn && existingCheckIn !== '') {
          console.log('⚠️ Already checked in today:', existingCheckIn);
          return {
            success: false,
            message: 'You have already checked in today at ' + existingCheckIn
          };
        } else {
          // FIX 1: Store time in 12-hour format
          attendanceSheet.getRange(rowNumber, checkInIndex + 1).setValue(timeString);
          attendanceSheet.getRange(rowNumber, statusIndex + 1).setValue(status);
          attendanceSheet.getRange(rowNumber, methodIndex + 1).setValue(mode);
          attendanceSheet.getRange(rowNumber, remarksIndex + 1).setValue(remarks);
          attendanceSheet.getRange(rowNumber, timestampIndex + 1).setValue(now.toISOString());
          attendanceSheet.getRange(rowNumber, actionIndex + 1).setValue(action);

          responseMessage = 'Check-in recorded successfully at ' + timeString;
          if (status === 'late') {
            responseMessage += ' (Marked as LATE - arrived after 10:30 AM)';
          }
          console.log('✅ Check-in recorded at:', timeString, 'Status:', status);
        }
      }
      else if (action === 'check-out') {
        // Check if check-out already exists
        if (existingCheckOut && existingCheckOut !== '') {
          console.log('⚠️ Already checked out today:', existingCheckOut);
          return {
            success: false,
            message: 'You have already checked out today at ' + existingCheckOut
          };
        }

        // Check if check-in exists
        if (!existingCheckIn || existingCheckIn === '') {
          console.log('⚠️ No check-in found. Forcing check-out anyway.');
          // Allow check-out even without check-in (mark as half-day?)
          status = 'half-day';
          remarks = 'Checked out without checking in';

          attendanceSheet.getRange(rowNumber, checkOutIndex + 1).setValue(timeString);
          attendanceSheet.getRange(rowNumber, statusIndex + 1).setValue(status);
          attendanceSheet.getRange(rowNumber, remarksIndex + 1).setValue(remarks);
          attendanceSheet.getRange(rowNumber, timestampIndex + 1).setValue(now.toISOString());
          attendanceSheet.getRange(rowNumber, actionIndex + 1).setValue(action);

          responseMessage = 'Check-out recorded at ' + timeString + ' (No check-in found)';
          console.log('✅ Check-out recorded without check-in');
        } else {
          // Normal check-out with valid check-in
          attendanceSheet.getRange(rowNumber, checkOutIndex + 1).setValue(timeString);

          // Calculate working hours (if check-in time is in 12-hour format)
          if (existingCheckIn) {
            try {
              // Parse 12-hour time back to calculate hours
              const checkInTime24 = parse12HourTo24Hour(existingCheckIn);
              const checkOutTime24 = time24Hour;

              const [inHour, inMin] = checkInTime24.split(':').map(Number);
              const [outHour, outMin] = checkOutTime24.split(':').map(Number);

              let totalMinutes = (outHour * 60 + outMin) - (inHour * 60 + inMin);

              // Subtract lunch break if more than 5 hours
              if (totalMinutes > 300) {
                totalMinutes -= 60;
              }

              const hours = Math.floor(totalMinutes / 60);
              const minutes = totalMinutes % 60;
              const totalHours = `${hours}h ${minutes}m`;

              attendanceSheet.getRange(rowNumber, totalHoursIndex + 1).setValue(totalHours);
              console.log('✅ Calculated working hours:', totalHours);
            } catch (e) {
              console.log('⚠️ Could not calculate working hours:', e.message);
            }
          }

          attendanceSheet.getRange(rowNumber, timestampIndex + 1).setValue(now.toISOString());
          attendanceSheet.getRange(rowNumber, actionIndex + 1).setValue(action);

          responseMessage = 'Check-out recorded successfully at ' + timeString;
          console.log('✅ Check-out recorded at:', timeString);
        }
      }
    } else {
      // No existing record for today - create new one
      const newRecord = [
        data.staffId,
        data.staffName || 'Staff Member',
        todayDate,
        action === 'check-in' ? timeString : '', // Check-in time (12-hour format)
        action === 'check-out' ? timeString : '', // Check-out time (12-hour format)
        status,
        mode,
        remarks,
        '', // TotalHours (will be calculated later)
        now.toISOString(),
        action
      ];

      attendanceSheet.appendRow(newRecord);

      if (action === 'check-in') {
        responseMessage = 'Check-in recorded successfully at ' + timeString;
        if (status === 'late') {
          responseMessage += ' (Marked as LATE - arrived after 10:30 AM)';
        }
      } else {
        responseMessage = 'Check-out recorded successfully at ' + timeString + ' (new record)';
        if (!newRecord[3]) { // No check-in
          status = 'half-day';
          remarks = 'Checked out without checking in';
          // Update the status after appending
          const lastRow = attendanceSheet.getLastRow();
          attendanceSheet.getRange(lastRow, statusIndex + 1).setValue(status);
          attendanceSheet.getRange(lastRow, remarksIndex + 1).setValue(remarks);
        }
      }

      console.log('✅ New attendance record created');
    }

    return {
      success: true,
      message: responseMessage,
      action: action,
      time: timeString,
      status: status
    };

  } catch (error) {
    console.error('❌ Error marking attendance:', error);
    return {
      success: false,
      message: 'Error: ' + error.toString()
    };
  }
}

// ==================== HELPER FUNCTIONS ====================

// Convert time to 12-hour format with AM/PM
function formatTime12Hour(date) {
  let hours = date.getHours();
  let minutes = date.getMinutes();
  const ampm = hours >= 12 ? 'PM' : 'AM';

  hours = hours % 12;
  hours = hours ? hours : 12; // Convert 0 to 12

  return hours.toString().padStart(2, '0') + ':' +
    minutes.toString().padStart(2, '0') + ' ' + ampm;
}

// Parse 12-hour time back to 24-hour for calculations
function parse12HourTo24Hour(time12h) {
  const [time, modifier] = time12h.split(' ');
  let [hours, minutes] = time.split(':');

  hours = parseInt(hours, 10);
  minutes = parseInt(minutes, 10);

  if (modifier === 'PM' && hours < 12) {
    hours += 12;
  }
  if (modifier === 'AM' && hours === 12) {
    hours = 0;
  }

  return hours.toString().padStart(2, '0') + ':' + minutes.toString().padStart(2, '0');
}

// ==================== DAILY ATTENDANCE SUMMARY (FOR ABSENTEES) ====================
function updateDailyAbsentStatus() {
  try {
    console.log('📅 Updating daily absent status...');

    const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
    const attendanceSheet = spreadsheet.getSheetByName('Staff_Attendance');
    const staffSheet = spreadsheet.getSheetByName('Staff');

    if (!attendanceSheet || !staffSheet) {
      console.log('❌ Required sheets not found');
      return;
    }

    const today = new Date();
    const todayISO = today.toISOString().split('T')[0];
    const todayDate = new Date(todayISO);

    // Get all active staff
    const staffData = staffSheet.getDataRange().getValues();
    const staffHeaders = staffData[0];
    const staffIdIndex = staffHeaders.indexOf('Staff ID');
    const staffNameIndex = staffHeaders.indexOf('Name');

    // Get today's attendance
    const attendanceData = attendanceSheet.getDataRange().getValues();
    const attendanceHeaders = attendanceData[0];
    const dateIndex = attendanceHeaders.indexOf('Date');
    const staffIdAttIndex = attendanceHeaders.indexOf('StaffID');
    const statusIndex = attendanceHeaders.indexOf('Status');

    // Collect staff who have attendance today
    const attendedStaff = new Set();

    for (let i = 1; i < attendanceData.length; i++) {
      const row = attendanceData[i];
      const rowDate = row[dateIndex];

      // Check if this is today's record
      let isToday = false;
      if (rowDate instanceof Date) {
        const rowDateStr = Utilities.formatDate(rowDate, Session.getScriptTimeZone(), 'yyyy-MM-dd');
        const todayStr = Utilities.formatDate(todayDate, Session.getScriptTimeZone(), 'yyyy-MM-dd');
        isToday = rowDateStr === todayStr;
      }

      if (isToday) {
        attendedStaff.add(row[staffIdAttIndex]);
      }
    }

    // Mark absentees (after 5 PM)
    const currentHour = today.getHours();
    if (currentHour >= 17) { // After 5 PM
      console.log('🕔 After 5 PM - marking absentees');

      for (let i = 1; i < staffData.length; i++) {
        const staffId = staffData[i][staffIdIndex];
        const staffName = staffData[i][staffNameIndex];

        if (staffId && !attendedStaff.has(staffId)) {
          // Staff didn't attend today - mark as absent
          const absentRecord = [
            staffId,
            staffName,
            todayDate,
            '', // No check-in
            '', // No check-out
            'absent',
            'auto',
            'No attendance recorded',
            '', // No working hours
            new Date().toISOString(),
            'auto-absent'
          ];

          attendanceSheet.appendRow(absentRecord);
          console.log(`✅ Marked ${staffName} (${staffId}) as ABSENT`);
        }
      }
    }

    return {
      success: true,
      message: 'Daily attendance summary updated',
      attended: attendedStaff.size,
      timeChecked: today.toISOString()
    };

  } catch (error) {
    console.error('❌ Error updating daily absent status:', error);
    return {
      success: false,
      message: 'Error: ' + error.toString()
    };
  }
}

// ==================== SCHEDULE DAILY ABSENT CHECK ====================
function scheduleDailyAbsentCheck() {
  // This can be set up as a daily trigger in Apps Script
  // Go to Edit > Current project's triggers > Add trigger
  // Set updateDailyAbsentStatus to run daily at 5:30 PM
  updateDailyAbsentStatus();
