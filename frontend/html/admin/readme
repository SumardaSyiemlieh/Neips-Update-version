// ==================== CENTER MANAGER LOGIN FUNCTIONS ====================

function getCenterManagers() {
  try {
    console.log('🔍 Getting center managers...');

    const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
    const centerManagersSheet = spreadsheet.getSheetByName('CenterManagers');

    if (!centerManagersSheet) {
      console.log('❌ CenterManagers sheet not found');
      return {
        success: false,
        message: 'CenterManagers sheet not found',
        managers: []
      };
    }

    const data = centerManagersSheet.getDataRange().getValues();
    const headers = data[0];
    const managers = [];

    for (let i = 1; i < data.length; i++) {
      const manager = {};
      headers.forEach((header, index) => {
        manager[header] = data[i][index];
      });
      managers.push(manager);
    }

    console.log(`✅ Found ${managers.length} center managers`);

    return {
      success: true,
      managers: managers
    };

  } catch (error) {
    console.error('❌ Error getting center managers:', error);
    return {
      success: false,
      message: 'Error: ' + error.toString(),
      managers: []
    };
  }
}

function verifyCenterManager(data) {
  try {
    console.log('🔐 Verifying center manager:', data.email);

    const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
    let centerManagersSheet = spreadsheet.getSheetByName('CenterManagers');

    // Auto-create sheet if it doesn't exist
    if (!centerManagersSheet) {
      console.log('📝 CenterManagers sheet not found, creating now...');
      centerManagersSheet = createCenterManagersSheetAuto(); // FIXED: Use the correct function name

      if (!centerManagersSheet) {
        return {
          success: false,
          message: 'Failed to create center managers database'
        };
      }
      console.log('✅ CenterManagers sheet created automatically');
    }

    const allData = centerManagersSheet.getDataRange().getValues();
    const headers = allData[0];

    // Normalize the entered DOB
    const normalizedEnteredDOB = normalizeDateForComparison(data.dob);
    console.log('📅 Normalized entered DOB:', normalizedEnteredDOB);

    // Find manager by email and date of birth
    for (let i = 1; i < allData.length; i++) {
      const row = allData[i];
      const managerEmail = row[headers.indexOf('Email')];
      const managerDOB = row[headers.indexOf('Date of Birth')] || row[headers.indexOf('DOB')];

      // Normalize stored DOB
      const normalizedStoredDOB = normalizeDateForComparison(managerDOB);

      if (managerEmail && managerEmail.toString().toLowerCase() === data.email.toLowerCase() &&
        normalizedStoredDOB === normalizedEnteredDOB) {

        console.log('✅ Center manager login successful for:', data.email);

        // Return manager data
        const managerData = {};
        headers.forEach((header, index) => {
          managerData[header] = row[index];
        });

        return {
          success: true,
          message: 'Login successful!',
          manager: managerData
        };
      }
    }

    console.log('❌ Center manager login failed for:', data.email);
    return {
      success: false,
      message: 'Invalid email or date of birth!'
    };

  } catch (error) {
    console.error('❌ Center manager login error:', error);
    return {
      success: false,
      message: 'Login failed: ' + error.toString()
    };
  }
}
