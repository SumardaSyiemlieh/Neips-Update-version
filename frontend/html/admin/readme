function initializeTasksSheet() {
  try {
    const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
    let tasksSheet = spreadsheet.getSheetByName('Tasks');

    if (!tasksSheet) {
      console.error('❌ Tasks sheet not found!');
      throw new Error('Tasks sheet not found. Please create a sheet named "Tasks"');
    }

    console.log('✅ Tasks sheet found:', tasksSheet.getName());
    return tasksSheet;

  } catch (error) {
    console.error('❌ Error initializing tasks sheet:', error);
    throw error;
  }
}
// DEBUG: Check Tasks sheet content
// DEBUG: Check Tasks sheet structure and content
// DEBUG: Check Tasks sheet structure and content - FIXED
// DEBUG: Check Tasks sheet - DIRECT VERSION
function debugTasksSheet() {
  try {
    const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
    const tasksSheet = spreadsheet.getSheetByName('Tasks');

    if (!tasksSheet) {
      return ContentService.createTextOutput(JSON.stringify({
        success: false,
        message: 'Tasks sheet not found!',
        availableSheets: spreadsheet.getSheets().map(s => s.getName())
      })).setMimeType(ContentService.MimeType.JSON);
    }

    const allData = tasksSheet.getDataRange().getValues();
    const headers = allData[0];

    const tasks = [];
    for (let i = 1; i < allData.length; i++) {
      const task = {
        row: i + 1,
        taskId: allData[i][headers.indexOf('TaskID')],
        title: allData[i][headers.indexOf('Title')],
        status: allData[i][headers.indexOf('Status')],
        completedDate: allData[i][headers.indexOf('CompletedDate')],
        completionNotes: allData[i][headers.indexOf('CompletionNotes')]
      };
      tasks.push(task);
    }

    const result = {
      success: true,
      totalTasks: tasks.length,
      headers: headers,
      tasks: tasks,
      sheetName: tasksSheet.getName()
    };

    return ContentService.createTextOutput(JSON.stringify(result))
      .setMimeType(ContentService.MimeType.JSON);

  } catch (error) {
    return ContentService.createTextOutput(JSON.stringify({
      success: false,
      error: error.toString()
    })).setMimeType(ContentService.MimeType.JSON);
  }
}

// Check column positions - DIRECT VERSION
function checkColumnPositions() {
  try {
    const tasksSheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('Tasks');
    const headers = tasksSheet.getRange(1, 1, 1, tasksSheet.getLastColumn()).getValues()[0];

    const positions = {};
    headers.forEach((header, index) => {
      positions[header] = index + 1;
    });

    const result = {
      success: true,
      columnPositions: positions,
      headers: headers
    };

    return ContentService.createTextOutput(JSON.stringify(result))
      .setMimeType(ContentService.MimeType.JSON);

  } catch (error) {
    return ContentService.createTextOutput(JSON.stringify({
      success: false,
      error: error.toString()
    })).setMimeType(ContentService.MimeType.JSON);
  }
}
// Admin assigns task
function assignTask(data) {
  try {
    console.log('📋 Assigning task:', data.title);

    const tasksSheet = initializeTasksSheet();
    const taskId = 'TASK' + new Date().getTime();
    const timestamp = new Date();

    const newTask = [
      taskId,
      data.title,
      data.description,
      data.assignedTo,      // 'center-manager'
      data.assignedBy,      // 'admin'
      timestamp,
      data.dueDate,
      'Assigned',
      data.priority || 'Medium',
      '', // CompletedDate
      '', // CompletionNotes
      data.center
    ];

    tasksSheet.appendRow(newTask);

    console.log('✅ Task assigned successfully:', taskId);

    return {
      success: true,
      message: 'Task assigned successfully!',
      taskId: taskId
    };

  } catch (error) {
    console.error('❌ Error assigning task:', error);
    return {
      success: false,
      message: 'Error assigning task: ' + error.toString()
    };
  }
}


// Get tasks for specific center
function getTasksForCenter(centerName) {
  try {
    const tasksSheet = initializeTasksSheet();
    const data = tasksSheet.getDataRange().getValues();
    const headers = data[0];

    const tasks = [];

    for (let i = 1; i < data.length; i++) {
      const row = data[i];
      const taskCenter = row[headers.indexOf('Center')];

      if (taskCenter === centerName) {
        const task = {};
        headers.forEach((header, index) => {
          task[header] = row[index];
        });
        tasks.push(task);
      }
    }

    return {
      success: true,
      tasks: tasks,
      count: tasks.length
    };

  } catch (error) {
    console.error('❌ Error getting tasks:', error);
    return {
      success: false,
      message: 'Error: ' + error.toString(),
      tasks: [],
      count: 0
    };
  }
}
// ==================== COMPLETE TASK MANAGEMENT SYSTEM ====================

// In your Apps Script - completeTask function
// ==================== COMPLETE TASK - FIXED VERSION ====================
// ==================== COMPLETE TASK - COMPLETELY FIXED VERSION ====================
function completeTask(data) {
  try {
    console.log('🎯 COMPLETE TASK STARTED:', data.taskId);
    console.log('📝 Notes:', data.notes);
    console.log('🏢 Center:', data.center);

    const tasksSheet = initializeTasksSheet();
    const allData = tasksSheet.getDataRange().getValues();
    const headers = allData[0];

    console.log('📋 ALL HEADERS:', headers);
    console.log('🔢 Header count:', headers.length);

    // Log each header with its index
    headers.forEach((header, index) => {
      console.log(`   ${index + 1}. ${header}`);
    });

    // Find task row
    let taskRow = -1;
    for (let i = 1; i < allData.length; i++) {
      const taskIdInSheet = allData[i][headers.indexOf('TaskID')];
      if (taskIdInSheet === data.taskId) {
        taskRow = i;
        console.log('✅ Found task at row:', taskRow + 1);
        console.log('📊 Current task data:', allData[i]);
        break;
      }
    }

    if (taskRow === -1) {
      console.log('❌ Task not found in sheet');
      return { success: false, message: 'Task not found' };
    }

    const rowNumber = taskRow + 1;

    // Find column indices
    const statusIndex = headers.indexOf('Status');
    const completionIndex = headers.indexOf('CompletedDate');
    const notesIndex = headers.indexOf('CompletionNotes');

    console.log('📍 COLUMN INDICES FOUND:');
    console.log('   - Status:', statusIndex);
    console.log('   - CompletedDate:', completionIndex);
    console.log('   - CompletionNotes:', notesIndex);

    // Update the cells
    if (statusIndex !== -1) {
      tasksSheet.getRange(rowNumber, statusIndex + 1).setValue('Completed');
      console.log('✅ Status updated to Completed');
    }

    if (completionIndex !== -1) {
      const now = new Date();
      tasksSheet.getRange(rowNumber, completionIndex + 1).setValue(now);
      console.log('✅ Completion date set:', now);
    }

    if (notesIndex !== -1) {
      tasksSheet.getRange(rowNumber, notesIndex + 1).setValue(data.notes || 'No notes provided');
      console.log('✅ Completion notes set');
    }

    // CRITICAL: Save changes
    SpreadsheetApp.flush();
    console.log('💾 Changes saved to database');

    // Verify changes
    const updatedData = tasksSheet.getRange(rowNumber, 1, 1, headers.length).getValues()[0];
    console.log('✅ VERIFICATION - Updated row:');
    console.log('   - Status:', updatedData[statusIndex]);
    console.log('   - CompletedDate:', updatedData[completionIndex]);
    console.log('   - CompletionNotes:', updatedData[notesIndex]);

    return {
      success: true,
      message: 'Task completed successfully!'
    };

  } catch (error) {
    console.error('❌ Error:', error);
    return { success: false, message: error.toString() };
  }
} // ==================== GET COMPLETED TASKS FOR ADMIN - FIXED ====================
