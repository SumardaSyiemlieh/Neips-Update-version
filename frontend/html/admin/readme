// ==================== GET AUTH STATUS - DEBUG VERSION ====================
function getAuthStatus(staffId) {
  try {
    console.log('🔍 Getting auth status for staff:', staffId);
    console.log('📋 Searching in Staff_Auth_Registry sheet...');

    const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();

    // ✅ FIRST: Check Staff_Auth_Registry sheet
    let authSheet = spreadsheet.getSheetByName('Staff_Auth_Registry');

    if (!authSheet) {
      console.log('❌ Staff_Auth_Registry sheet not found!');
      return {
        success: false,
        message: 'Staff_Auth_Registry sheet not found',
        faceRegistered: false,
        biometricRegistered: false
      };
    }

    console.log('✅ Found Staff_Auth_Registry sheet');
    const allData = authSheet.getDataRange().getValues();
    const headers = allData[0];

    console.log('📊 Sheet headers:', headers);
    console.log('📈 Total rows in auth registry:', allData.length);

    // Find staff in auth registry
    for (let i = 1; i < allData.length; i++) {
      const rowStaffId = allData[i][headers.indexOf('StaffID')];
      const email = allData[i][headers.indexOf('Email')];

      console.log(`🔍 Checking row ${i}: StaffID="${rowStaffId}", Email="${email}"`);

      if (rowStaffId === staffId || email === staffId) {
        const faceRegistered = allData[i][headers.indexOf('FaceRegistered')] === 'YES';
        const biometricRegistered = allData[i][headers.indexOf('BiometricRegistered')] === 'YES';

        console.log(`✅ FOUND STAFF in Auth Registry:`);
        console.log(`   - FaceRegistered: ${faceRegistered}`);
        console.log(`   - BiometricRegistered: ${biometricRegistered}`);
        console.log(`   - Row Data:`, allData[i]);

        return {
          success: true,
          faceRegistered: faceRegistered,
          biometricRegistered: biometricRegistered,
          preferredMethod: allData[i][headers.indexOf('PreferredMethod')] || 'none',
          lastUsed: allData[i][headers.indexOf('LastUsed')] || '',
          status: allData[i][headers.indexOf('Status')] || 'Active'
        };
      }
    }

    // If not found in auth registry, check Staff sheet
    console.log('⚠️ Staff not found in Auth Registry, checking Staff sheet...');
    const staffSheet = spreadsheet.getSheetByName('Staff');

    if (staffSheet) {
      const staffData = staffSheet.getDataRange().getValues();
      const staffHeaders = staffData[0];

      console.log('📊 Staff sheet headers:', staffHeaders);

      for (let i = 1; i < staffData.length; i++) {
        const rowStaffId = staffData[i][staffHeaders.indexOf('Staff ID')] || staffData[i][staffHeaders.indexOf('StaffID')];

        if (rowStaffId === staffId) {
          console.log(`✅ Found in Staff sheet (no auth data yet)`);
          return {
            success: true,
            faceRegistered: false,
            biometricRegistered: false,
            message: 'Staff found but not registered for authentication'
          };
        }
      }
    }

    console.log('❌ Staff not found in any sheet:', staffId);
    return {
      success: true,
      faceRegistered: false,
      biometricRegistered: false,
      message: 'Staff not found in database'
    };

  } catch (error) {
    console.error('❌ Error in getAuthStatus:', error);
    console.error('❌ Stack trace:', error.stack);
    return {
      success: false,
      message: 'Error: ' + error.toString(),
      errorDetails: error.stack
    };
  }
