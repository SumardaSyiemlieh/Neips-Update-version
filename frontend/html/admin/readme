// ==================== BATCH MANAGEMENT - COMPLETE SOLUTION ====================
function handleBatchActions(e) {
  try {
    const action = e.parameter.action;
    console.log('🎯 Batch Action:', action);

    if (action === 'saveBatch') {
      const batchData = JSON.parse(e.parameter.batchData);
      return saveBatchToSheet(batchData);
    }
    else if (action === 'getBatches') {
      return getBatchesFromSheet();
    }
    else if (action === 'deleteBatch') {
      return deleteBatchFromSheet(e.parameter.batchId);
    }
    else {
      return createJSONResponse({
        success: false,
        message: 'Unknown batch action: ' + action
      });
    }
  } catch (error) {
    console.error('❌ Batch action error:', error);
    return createJSONResponse({
      success: false,
      message: 'Error: ' + error.toString()
    });
  }
}


function getBatches() {
  try {
    console.log('📚 Getting batches from database...');

    var spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
    var sheet = spreadsheet.getSheetByName('Batches');

    if (!sheet) {
      console.log('❌ Batches sheet not found');
      return {
        success: false,
        message: 'Batches sheet not found',
        batches: []
      };
    }

    var data = sheet.getDataRange().getValues();
    var headers = data[0];
    var batches = [];

    console.log('📊 Found', data.length, 'rows in Batches sheet');
    console.log('📋 Headers:', headers);

    for (var i = 1; i < data.length; i++) {
      var row = data[i];
      var batch = {};
      for (var j = 0; j < headers.length; j++) {
        batch[headers[j]] = row[j];
      }
      batches.push(batch);
    }

    console.log('✅ Retrieved', batches.length, 'batches');

    return {
      success: true,
      batches: batches,
      message: 'Batches retrieved successfully'
    };

  } catch (error) {
    console.error('❌ Error retrieving batches: ' + error.toString());
    return {
      success: false,
      message: 'Error retrieving batches: ' + error.toString(),
      batches: []
    };
  }
} function saveBatch(batchData) {
  try {
    console.log('💾 Starting batch save process...');

    var spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
    var sheet = spreadsheet.getSheetByName('Batches');

    // If Batches sheet doesn't exist, create it
    if (!sheet) {
      console.log('📄 Creating new Batches sheet...');
      sheet = spreadsheet.insertSheet('Batches');
      // Create headers
      var headers = ['BatchID', 'Sector', 'Trade', 'MaxCapacity', 'StartDate', 'EndDate', 'StartTime', 'EndTime', 'Faculty', 'Status', 'Students', 'Center', 'CreatedDate', 'LastUpdated'];
      sheet.getRange(1, 1, 1, headers.length).setValues([headers]);
      console.log('✅ Batches sheet created with headers');
    }

    console.log('📝 Parsing batch data...');
    var data = JSON.parse(batchData);
    console.log('📊 Batch data parsed:', data.BatchID);

    // Get existing data to find last row
    var lastRow = sheet.getLastRow();
    var isNewBatch = true;
    var updateRow = lastRow + 1;

    console.log('🔍 Checking if batch exists... Last row:', lastRow);

    // Check if batch already exists (for updating)
    if (lastRow > 0) {
      var existingData = sheet.getRange(1, 1, lastRow, 1).getValues(); // BatchID column
      for (var i = 1; i < existingData.length; i++) {
        if (existingData[i][0] === data.BatchID) {
          isNewBatch = false;
          updateRow = i + 1;
          console.log('🔄 Updating existing batch at row:', updateRow);
          break;
        }
      }
    }

    if (isNewBatch) {
      console.log('🆕 Creating new batch at row:', updateRow);
    }

    // Prepare row data
    var rowData = [
      data.BatchID || '',
      data.Sector || '',
      data.Trade || '',
      data.MaxCapacity || 30,
      data.StartDate || '',
      data.EndDate || '',
      data.StartTime || '09:00',
      data.EndTime || '17:00',
      data.Faculty || '',
      data.Status || 'Upcoming',
      JSON.stringify(data.Students || []),
      data.Center || '',
      data.CreatedDate || new Date().toISOString(),
      new Date().toISOString()
    ];

    console.log('📋 Row data prepared:', rowData);

    if (isNewBatch) {
      sheet.getRange(updateRow, 1, 1, rowData.length).setValues([rowData]);
      console.log('✅ New batch saved successfully');
    } else {
      sheet.getRange(updateRow, 2, 1, rowData.length - 1).setValues([rowData.slice(1)]);
      console.log('✅ Existing batch updated successfully');
    }

    return {
      success: true,
      message: 'Batch saved successfully',
      batchId: data.BatchID
    };

  } catch (error) {
    console.error('❌ Error saving batch: ' + error.toString());
    return {
      success: false,
      message: 'Error saving batch: ' + error.toString()
    };
  }
}
function deleteBatch(batchId) {
  try {
    console.log('🗑️ Deleting batch:', batchId);

    var spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
    var sheet = spreadsheet.getSheetByName('Batches');

    if (!sheet) {
      console.log('❌ Batches sheet not found');
      return { success: false, message: 'Batches sheet not found' };
    }

    var data = sheet.getDataRange().getValues();
    var batchIdColumn = 0; // Assuming BatchID is in column A

    console.log('🔍 Searching for batch in', data.length, 'rows...');

    for (var i = data.length - 1; i >= 1; i--) { // Start from 1 to skip header
      if (data[i][batchIdColumn] === batchId) {
        console.log('✅ Found batch at row:', i + 1);
        sheet.deleteRow(i + 1);
        console.log('✅ Batch deleted successfully');
        return {
          success: true,
          message: 'Batch deleted successfully'
        };
      }
    }

    console.log('❌ Batch not found:', batchId);
    return {
      success: false,
      message: 'Batch not found'
    };

  } catch (error) {
    console.error('❌ Error deleting batch: ' + error.toString());
    return {
      success: false,
      message: 'Error deleting batch: ' + error.toString()
    };
  }
}
// ==================== BATCH APPROVAL SYSTEM ====================

// ==================== SEND BATCH FOR APPROVAL - UPDATED ====================
function sendBatchForApproval(data) {
  try {
    console.log('📤 Sending batch for approval:', data.batchId);

    const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
    let batchesSheet = spreadsheet.getSheetByName('Batches');

    if (!batchesSheet) {
      return {
        success: false,
        message: 'Batches sheet not found'
      };
    }

    const allData = batchesSheet.getDataRange().getValues();
    const headers = allData[0];

    // Find the batch
    let batchRow = -1;
    let batchData = null;

    for (let i = 1; i < allData.length; i++) {
      if (allData[i][headers.indexOf('BatchID')] === data.batchId) {
        batchRow = i;
        batchData = {};
        headers.forEach((header, index) => {
          batchData[header] = allData[i][index];
        });
        break;
      }
    }

    if (batchRow === -1) {
      return {
        success: false,
        message: 'Batch not found'
      };
    }

    const rowNumber = batchRow + 1;
    const timestamp = new Date();

    // Update approval status to "pending"
    const approvalStatusIndex = headers.indexOf('ApprovalStatus');
    if (approvalStatusIndex !== -1) {
      batchesSheet.getRange(rowNumber, approvalStatusIndex + 1).setValue('pending');
    } else {
      // If ApprovalStatus column doesn't exist, create it
      const lastCol = batchesSheet.getLastColumn();
      batchesSheet.getRange(1, lastCol + 1).setValue('ApprovalStatus');
      batchesSheet.getRange(rowNumber, lastCol + 1).setValue('pending');
    }

    // Update main status to show it's pending approval
    const statusIndex = headers.indexOf('Status');
    if (statusIndex !== -1) {
      batchesSheet.getRange(rowNumber, statusIndex + 1).setValue('Pending Approval');
    }

    // Update last updated timestamp
    const lastUpdatedIndex = headers.indexOf('LastUpdated');
    if (lastUpdatedIndex !== -1) {
      batchesSheet.getRange(rowNumber, lastUpdatedIndex + 1).setValue(timestamp);
    }

    // Add approval request details
    const approvalRequestedByIndex = headers.indexOf('ApprovalRequestedBy');
    if (approvalRequestedByIndex === -1) {
      const lastCol = batchesSheet.getLastColumn();
      batchesSheet.getRange(1, lastCol + 1).setValue('ApprovalRequestedBy');
      batchesSheet.getRange(rowNumber, lastCol + 1).setValue(data.createdBy || 'Staff');
    } else {
      batchesSheet.getRange(rowNumber, approvalRequestedByIndex + 1).setValue(data.createdBy || 'Staff');
    }

    const approvalRequestedDateIndex = headers.indexOf('ApprovalRequestedDate');
    if (approvalRequestedDateIndex === -1) {
      const lastCol = batchesSheet.getLastColumn();
      batchesSheet.getRange(1, lastCol + 1).setValue('ApprovalRequestedDate');
      batchesSheet.getRange(rowNumber, lastCol + 1).setValue(timestamp);
    } else {
      batchesSheet.getRange(rowNumber, approvalRequestedDateIndex + 1).setValue(timestamp);
    }

    console.log('✅ Batch sent for approval successfully:', data.batchId);

    return {
      success: true,
      message: 'Batch sent for admin approval successfully!'
    };

  } catch (error) {
    console.error('❌ Error sending batch for approval:', error);
    return {
      success: false,
      message: 'Error: ' + error.toString()
    };
  }
}// Get batch approvals for admin
// ==================== GET BATCH APPROVALS - IMPROVED ====================
function getBatchApprovals() {
  try {
    console.log('📋 Getting ALL batches for approval system...');

    const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
    let batchesSheet = spreadsheet.getSheetByName('Batches');

    if (!batchesSheet) {
      console.log('❌ Batches sheet not found');
      return {
        success: true,
        batches: [],
        message: 'No batches sheet found'
      };
    }

    const allData = batchesSheet.getDataRange().getValues();
    const headers = allData[0];

    const batches = [];

    console.log('📊 Total batches in sheet:', allData.length - 1);
    console.log('📋 Headers:', headers);

    // Get column indices
    const approvalStatusIndex = headers.indexOf('ApprovalStatus');
    const statusIndex = headers.indexOf('Status');
    const batchIdIndex = headers.indexOf('BatchID');
    const centerIndex = headers.indexOf('Center');
    const tradeIndex = headers.indexOf('Trade');
    const facultyIndex = headers.indexOf('Faculty');
    const startDateIndex = headers.indexOf('StartDate');
    const endDateIndex = headers.indexOf('EndDate');
    const studentsIndex = headers.indexOf('Students');
    const maxCapacityIndex = headers.indexOf('MaxCapacity');
    const createdDateIndex = headers.indexOf('CreatedDate');
    const lastUpdatedIndex = headers.indexOf('LastUpdated');

    for (let i = 1; i < allData.length; i++) {
      const row = allData[i];
      const batch = {};

      // Map all available data
      headers.forEach((header, index) => {
        batch[header] = row[index];
      });

      // Determine approval status
      let approvalStatus = 'draft';

      // First check ApprovalStatus column
      if (approvalStatusIndex !== -1 && row[approvalStatusIndex]) {
        approvalStatus = row[approvalStatusIndex].toString().toLowerCase();
      }
      // Fallback to Status column
      else if (statusIndex !== -1 && row[statusIndex]) {
        const status = row[statusIndex].toString().toLowerCase();
        if (status.includes('pending') || status.includes('approval')) {
          approvalStatus = 'pending';
        } else if (status.includes('approved') || status.includes('active')) {
          approvalStatus = 'approved';
        } else if (status.includes('rejected')) {
          approvalStatus = 'rejected';
        }
      }

      batch.approval_status = approvalStatus;

      // Ensure we have all required fields for display
      batch.batch_id = batch.BatchID || `BATCH-${i}`;
      batch.center = batch.Center || 'Unknown Center';
      batch.trade = batch.Trade || 'Unknown Trade';
      batch.faculty = batch.Faculty || 'Not assigned';
      batch.created_date = batch.CreatedDate || batch.LastUpdated || new Date().toISOString();

      // Calculate student count
      try {
        if (batch.Students && typeof batch.Students === 'string' && batch.Students.trim() !== '') {
          const students = JSON.parse(batch.Students);
          batch.student_count = Array.isArray(students) ? students.length : 0;
        } else {
          batch.student_count = 0;
        }
      } catch (e) {
        batch.student_count = 0;
      }

      batch.max_capacity = batch.MaxCapacity || 30;

      batches.push(batch);

      console.log(`📦 Batch ${batch.batch_id}: ${approvalStatus} - ${batch.center}`);
    }

    console.log(`✅ Processed ${batches.length} batches for approval system`);

    return {
      success: true,
      batches: batches,
      total: batches.length,
      pending: batches.filter(b => b.approval_status === 'pending').length,
      approved: batches.filter(b => b.approval_status === 'approved').length,
      rejected: batches.filter(b => b.approval_status === 'rejected').length,
      draft: batches.filter(b => b.approval_status === 'draft').length
    };

  } catch (error) {
    console.error('❌ Error getting batch approvals:', error);
    return {
      success: false,
      message: 'Error: ' + error.toString(),
      batches: [],
      total: 0
    };
  }
}// Update batch approval status (Admin side)
// ==================== BATCH APPROVAL STATUS UPDATE ====================
// ==================== BATCH APPROVAL SYSTEM - COMPLETE SOLUTION ====================

// Get batch approvals for admin dashboard
// ==================== FIXED BATCH APPROVAL STATUS DETECTION ====================
function getBatchApprovals() {
  try {
    console.log('📋 Getting ALL batches for approval system...');

    const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
    let batchesSheet = spreadsheet.getSheetByName('Batches');

    if (!batchesSheet) {
      console.log('❌ Batches sheet not found');
      return {
        success: true,
        batches: [],
        message: 'No batches sheet found'
      };
    }

    const allData = batchesSheet.getDataRange().getValues();
    const headers = allData[0];

    const batches = [];

    console.log('📊 Total batches in sheet:', allData.length - 1);
    console.log('📋 Headers:', headers);

    // Get column indices
    const batchIdIndex = headers.indexOf('BatchID');
    const centerIndex = headers.indexOf('Center');
    const tradeIndex = headers.indexOf('Trade');
    const facultyIndex = headers.indexOf('Faculty');
    const startDateIndex = headers.indexOf('StartDate');
    const endDateIndex = headers.indexOf('EndDate');
    const studentsIndex = headers.indexOf('Students');
    const maxCapacityIndex = headers.indexOf('MaxCapacity');
    const statusIndex = headers.indexOf('Status');
    const approvalStatusIndex = headers.indexOf('ApprovalStatus');
    const createdDateIndex = headers.indexOf('CreatedDate');
    const lastUpdatedIndex = headers.indexOf('LastUpdated');

    for (let i = 1; i < allData.length; i++) {
      const row = allData[i];
      const batch = {};

      // Map all available data
      headers.forEach((header, index) => {
        batch[header] = row[index];
      });

      // FIXED: Better approval status detection
      let approvalStatus = 'draft';

      // Check multiple indicators for pending approval
      const status = statusIndex !== -1 ? (row[statusIndex] || '').toString().toLowerCase() : '';
      const approvalStatusValue = approvalStatusIndex !== -1 ? (row[approvalStatusIndex] || '').toString().toLowerCase() : '';

      // Priority: Explicit approval status > Status column > Default to draft
      if (approvalStatusValue) {
        approvalStatus = approvalStatusValue;
      } else if (status) {
        if (status.includes('pending') || status.includes('approval') || status === 'pending approval') {
          approvalStatus = 'pending';
        } else if (status.includes('approved') || status.includes('active')) {
          approvalStatus = 'approved';
        } else if (status.includes('rejected')) {
          approvalStatus = 'rejected';
        } else if (status.includes('draft')) {
          approvalStatus = 'draft';
        }
      }

      // Additional check: If batch has students but no explicit status, consider it pending
      try {
        if (batch.Students && typeof batch.Students === 'string' && batch.Students.trim() !== '') {
          const students = JSON.parse(batch.Students);
          if (Array.isArray(students) && students.length > 0 && approvalStatus === 'draft') {
            approvalStatus = 'pending';
          }
        }
      } catch (e) {
        // Ignore parsing errors
      }

      batch.approval_status = approvalStatus;

      // Ensure we have all required fields for display
      batch.batch_id = batch.BatchID || `BATCH-${i}`;
      batch.center = batch.Center || 'Unknown Center';
      batch.trade = batch.Trade || 'Unknown Trade';
      batch.faculty = batch.Faculty || 'Not assigned';
      batch.created_date = batch.CreatedDate || batch.LastUpdated || new Date().toISOString();

      // Calculate student count
      try {
        if (batch.Students && typeof batch.Students === 'string' && batch.Students.trim() !== '') {
          const students = JSON.parse(batch.Students);
          batch.student_count = Array.isArray(students) ? students.length : 0;
        } else {
          batch.student_count = 0;
        }
      } catch (e) {
        batch.student_count = 0;
      }

      batch.max_capacity = batch.MaxCapacity || 30;
      batch.start_date = batch.StartDate || '';
      batch.end_date = batch.EndDate || '';

      batches.push(batch);

      console.log(`📦 Batch ${batch.batch_id}: ${approvalStatus} - ${batch.center} - Students: ${batch.student_count}`);
    }

    console.log(`✅ Processed ${batches.length} batches for approval system`);

    const pendingBatches = batches.filter(b => b.approval_status === 'pending');
    const approvedBatches = batches.filter(b => b.approval_status === 'approved');
    const rejectedBatches = batches.filter(b => b.approval_status === 'rejected');
    const draftBatches = batches.filter(b => b.approval_status === 'draft');

    console.log(`📊 Status Summary: ${pendingBatches.length} pending, ${approvedBatches.length} approved, ${rejectedBatches.length} rejected, ${draftBatches.length} draft`);

    return {
      success: true,
      batches: batches,
      total: batches.length,
      pending: pendingBatches.length,
      approved: approvedBatches.length,
      rejected: rejectedBatches.length,
      draft: draftBatches.length
    };

  } catch (error) {
    console.error('❌ Error getting batch approvals:', error);
    return {
      success: false,
      message: 'Error: ' + error.toString(),
      batches: [],
      total: 0
    };
  }
}// Update batch approval status
function updateBatchApproval(data) {
  try {
    console.log('🔄 Updating batch approval:', data.batchId, 'to:', data.approvalStatus);

    const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
    let batchesSheet = spreadsheet.getSheetByName('Batches');

    if (!batchesSheet) {
      console.log('❌ Batches sheet not found');
      return { success: false, message: 'Batches sheet not found' };
    }

    const allData = batchesSheet.getDataRange().getValues();
    const headers = allData[0];

    // Find the batch
    let batchRow = -1;
    for (let i = 1; i < allData.length; i++) {
      if (allData[i][headers.indexOf('BatchID')] === data.batchId) {
        batchRow = i;
        break;
      }
    }

    if (batchRow === -1) {
      return { success: false, message: 'Batch not found' };
    }

    const rowNumber = batchRow + 1;
    const timestamp = new Date();

    // Update approval status column
    const approvalStatusIndex = headers.indexOf('ApprovalStatus');
    if (approvalStatusIndex !== -1) {
      batchesSheet.getRange(rowNumber, approvalStatusIndex + 1).setValue(data.approvalStatus);
    } else {
      // If ApprovalStatus column doesn't exist, add it
      const lastCol = batchesSheet.getLastColumn();
      batchesSheet.getRange(1, lastCol + 1).setValue('ApprovalStatus');
      batchesSheet.getRange(rowNumber, lastCol + 1).setValue(data.approvalStatus);
    }

    // Update status column
    const statusIndex = headers.indexOf('Status');
    if (statusIndex !== -1) {
      if (data.approvalStatus === 'approved') {
        batchesSheet.getRange(rowNumber, statusIndex + 1).setValue('Active');
      } else if (data.approvalStatus === 'rejected') {
        batchesSheet.getRange(rowNumber, statusIndex + 1).setValue('Rejected');
      } else if (data.approvalStatus === 'pending') {
        batchesSheet.getRange(rowNumber, statusIndex + 1).setValue('Pending Approval');
      }
    }

    // Update approval notes if provided
    if (data.approvalNotes) {
      const approvalNotesIndex = headers.indexOf('ApprovalNotes');
      if (approvalNotesIndex !== -1) {
        batchesSheet.getRange(rowNumber, approvalNotesIndex + 1).setValue(data.approvalNotes);
      } else {
        const lastCol = batchesSheet.getLastColumn();
        batchesSheet.getRange(1, lastCol + 1).setValue('ApprovalNotes');
        batchesSheet.getRange(rowNumber, lastCol + 1).setValue(data.approvalNotes);
      }
    }

    // Update approved by and date
    const approvedByIndex = headers.indexOf('ApprovedBy');
    if (approvedByIndex !== -1) {
      batchesSheet.getRange(rowNumber, approvedByIndex + 1).setValue(data.approvedBy || 'admin');
    }

    const approvedDateIndex = headers.indexOf('ApprovedDate');
    if (approvedDateIndex !== -1) {
      batchesSheet.getRange(rowNumber, approvedDateIndex + 1).setValue(data.approvedDate || timestamp);
    }

    // Update last updated
    const lastUpdatedIndex = headers.indexOf('LastUpdated');
    if (lastUpdatedIndex !== -1) {
      batchesSheet.getRange(rowNumber, lastUpdatedIndex + 1).setValue(timestamp);
    }

    console.log('✅ Batch approval updated successfully');
    return {
      success: true,
      message: `Batch ${data.approvalStatus} successfully!`
    };

  } catch (error) {
    console.error('❌ Error updating batch approval:', error);
    return {
      success: false,
      message: 'Error: ' + error.toString()
    };
  }
}

