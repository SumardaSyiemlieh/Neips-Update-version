// ==================== DISTRICT SHEET MANAGEMENT ====================

function createDistrictSheetIfNotExists(districtName) {
  try {
    const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();

    // Clean district name for sheet name (remove special characters, limit to 31 chars)
    const sheetName = districtName.replace(/[\/\\?*[\]]/g, '')
      .substring(0, 31);

    let sheet = spreadsheet.getSheetByName(sheetName);

    if (!sheet) {
      // Create new district sheet
      sheet = spreadsheet.insertSheet(sheetName);

      // Create headers
      const headers = [
        'Timestamp', 'Name', 'Email', 'Phone', 'Trade', 'Status',
        'Unique ID', 'Date of Birth', 'Address', 'Photo',
        'Project', 'ID Card Number', 'Approval Date', 'Rejection Reason'
      ];

      sheet.getRange(1, 1, 1, headers.length).setValues([headers]);

      // Format header row
      sheet.getRange(1, 1, 1, headers.length)
        .setBackground('#4a86e8')
        .setFontColor('white')
        .setFontWeight('bold');

      // Set column widths
      sheet.setColumnWidth(1, 180); // Timestamp
      sheet.setColumnWidth(2, 150); // Name
      sheet.setColumnWidth(3, 200); // Email
      sheet.setColumnWidth(4, 120); // Phone
      sheet.setColumnWidth(5, 150); // Trade
      sheet.setColumnWidth(6, 100); // Status
      sheet.setColumnWidth(7, 120); // Unique ID
      sheet.setColumnWidth(8, 120); // Date of Birth
      sheet.setColumnWidth(9, 200); // Address
      sheet.setColumnWidth(10, 100); // Photo (hidden)

      console.log(`✅ Created new district sheet: ${sheetName}`);
    }

    return sheet;

  } catch (error) {
    console.error(`❌ Error creating district sheet ${districtName}:`, error);
    throw error;
  }
}

// ==================== TRADE CAPACITY MANAGEMENT ====================

// ==================== UPDATED TRADE CAPACITY MANAGEMENT ====================

function getTradeCapacity(districtName, trade) {
  try {
    console.log(`🔍 Getting capacity for ${trade} in ${districtName}`);

    const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();

    // Try to find the district-specific sheet first
    const sheetName = districtName.replace(/[\/\\?*[\]]/g, '').substring(0, 31);
    let sheet = spreadsheet.getSheetByName(sheetName);

    // If district sheet doesn't exist, check ALL sheets for students in this district
    if (!sheet) {
      console.log(`📄 District sheet ${sheetName} not found, checking all sheets...`);
      return getCapacityFromAllSheets(districtName, trade);
    }

    // Count students in this trade from district sheet
    const data = sheet.getDataRange().getValues();
    const headers = data[0];
    const tradeIndex = headers.indexOf('Trade');
    const districtIndex = headers.indexOf('Address') || headers.indexOf('Center');

    if (tradeIndex === -1) {
      console.log('❌ Trade column not found in district sheet');
      return {
        current: 0,
        max: 30,
        available: 30,
        isFull: false
      };
    }

    let count = 0;
    for (let i = 1; i < data.length; i++) {
      const rowTrade = data[i][tradeIndex];
      const rowDistrict = districtIndex !== -1 ? data[i][districtIndex] : districtName;

      // Count if trade matches AND district matches (if district column exists)
      if (rowTrade === trade) {
        if (!districtIndex || rowDistrict === districtName) {
          count++;
        }
      }
    }

    const maxCapacity = 30;
    const available = Math.max(0, maxCapacity - count);
    const isFull = count >= maxCapacity;

    console.log(`📊 ${trade} in ${districtName}: ${count}/${maxCapacity} (${available} available)`);

    return {
      current: count,
      max: maxCapacity,
      available: available,
      isFull: isFull
    };

  } catch (error) {
    console.error(`❌ Error getting trade capacity for ${trade} in ${districtName}:`, error);
    return {
      current: 0,
      max: 30,
      available: 30,
      isFull: false,
      error: error.toString()
    };
  }
}

// NEW FUNCTION: Check capacity from ALL sheets
function getCapacityFromAllSheets(districtName, trade) {
  try {
    console.log(`🔍 Checking ALL sheets for ${trade} in ${districtName}`);

    const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
    const sheets = spreadsheet.getSheets();
    let totalCount = 0;

    for (const sheet of sheets) {
      const data = sheet.getDataRange().getValues();
      if (data.length <= 1) continue; // Skip if only headers

      const headers = data[0];
      const tradeIndex = headers.indexOf('Trade');
      const districtIndex = headers.indexOf('Address') || headers.indexOf('Center');

      if (tradeIndex === -1) continue; // Skip if no Trade column

      for (let i = 1; i < data.length; i++) {
        const rowTrade = data[i][tradeIndex];
        let rowDistrict = districtName; // Default to the district we're checking

        if (districtIndex !== -1) {
          rowDistrict = data[i][districtIndex];
        }

        // Count if trade matches AND district matches
        if (rowTrade === trade && rowDistrict === districtName) {
          totalCount++;
        }
      }
    }

    const maxCapacity = 30;
    const available = Math.max(0, maxCapacity - totalCount);
    const isFull = totalCount >= maxCapacity;

    console.log(`📊 TOTAL from all sheets: ${trade} in ${districtName}: ${totalCount}/${maxCapacity} (${available} available)`);

    return {
      current: totalCount,
      max: maxCapacity,
      available: available,
      isFull: isFull,
      source: 'all_sheets'
    };

  } catch (error) {
    console.error(`❌ Error checking all sheets:`, error);
    return {
      current: 0,
      max: 30,
      available: 30,
      isFull: false
    };
  }
}
