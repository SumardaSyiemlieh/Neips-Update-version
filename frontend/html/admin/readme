function checkTasksSheetSimple() {
  try {
    const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();

    // Check if Tasks sheet exists
    const tasksSheet = spreadsheet.getSheetByName('Tasks');
    if (!tasksSheet) {
      return {
        success: false,
        message: '❌ Tasks sheet not found!',
        availableSheets: spreadsheet.getSheets().map(s => s.getName())
      };
    }

    // Get basic info
    const data = tasksSheet.getDataRange().getValues();
    const headers = data[0];

    // Count completed tasks
    const statusIndex = headers.indexOf('Status');
    let completedCount = 0;
    let allTasks = [];

    if (statusIndex !== -1) {
      for (let i = 1; i < data.length; i++) {
        const task = {
          id: data[i][headers.indexOf('TaskID')],
          title: data[i][headers.indexOf('Title')],
          status: data[i][statusIndex],
          completedDate: data[i][headers.indexOf('CompletedDate')]
        };
        allTasks.push(task);

        if (task.status === 'Completed') {
          completedCount++;
        }
      }
    }

    return {
      success: true,
      tasksSheetExists: true,
      totalTasks: data.length - 1,
      completedTasks: completedCount,
      headers: headers,
      allTasks: allTasks,
      statusColumnIndex: statusIndex
    };

  } catch (error) {
    return {
      success: false,
      error: error.toString()
    };
  }
}
