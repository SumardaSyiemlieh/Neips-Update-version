    return {
      success: false,
      message: 'Error: ' + error.toString(),
      availableTrades: [],
      totalAvailable: 0
    };
  }
}// ==================== UPDATED STUDENT REGISTRATION ====================

function handleStudentRegistration(data, sheet, headers) {
  try {
    console.log('🎯 DEBUG: handleStudentRegistration started');
    console.log('📝 Received data for district:', data.address);
    console.log('📊 Selected trade:', data.trade);

    // Validate required fields
    const requiredFields = ['name', 'email', 'phone', 'trade', 'address'];
    const missingFields = requiredFields.filter(field => !data[field]);

    if (missingFields.length > 0) {
      console.log('❌ Missing fields:', missingFields);
      return {
        success: false,
        message: 'Missing required fields: ' + missingFields.join(', ')
      };
    }

    // Check trade capacity before proceeding
    const capacityInfo = getTradeCapacity(data.address, data.trade);

    if (capacityInfo.isFull) {
      console.log(`❌ Trade ${data.trade} is full in ${data.address}`);
      return {
        success: false,
        message: `Sorry, ${data.trade.split('-')[1]} is full (${capacityInfo.current}/${capacityInfo.max}). Please select another trade.`,
        capacity: capacityInfo
      };
    }

    // Check if email already exists in ANY district sheet
    console.log('🔍 Checking for duplicate email:', data.email);
    const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
    const sheets = spreadsheet.getSheets();

    for (const sheet of sheets) {
      const sheetData = sheet.getDataRange().getValues();
      const sheetHeaders = sheetData[0];
      const emailIndex = sheetHeaders.indexOf('Email');

      if (emailIndex !== -1) {
        for (let i = 1; i < sheetData.length; i++) {
          const studentEmail = sheetData[i][emailIndex];
          if (studentEmail && studentEmail.toString().toLowerCase() === data.email.toLowerCase()) {
            console.log('❌ Duplicate email found in', sheet.getName());
            return {
              success: false,
              message: 'Email already registered in ' + sheet.getName() + '. Please use a different email.'
            };
          }
        }
      }
    }

    // Create/Get district-specific sheet
    const districtSheet = createDistrictSheetIfNotExists(data.address);

    if (!districtSheet) {
      return {
        success: false,
        message: 'Failed to create district sheet'
      };
    }

    // Get headers from district sheet
    const districtData = districtSheet.getDataRange().getValues();
    const districtHeaders = districtData.length > 0 ? districtData[0] : headers;

    const timestamp = new Date();
    const uniqueId = 'NEIPS' + Math.random().toString(36).substr(2, 9).toUpperCase();

    console.log('🆕 Generated Student ID:', uniqueId);

    // Prepare row data
    const rowData = [];
    for (let i = 0; i < districtHeaders.length; i++) {
      rowData[i] = '';
    }

    // Map data to columns
    districtHeaders.forEach((header, index) => {
      switch (header) {
        case 'Timestamp':
          rowData[index] = timestamp.toISOString();
          break;
        case 'Name':
          rowData[index] = data.name || '';
          break;
        case 'Email':
          rowData[index] = data.email || '';
          break;
        case 'Phone':
          rowData[index] = data.phone || '';
          break;
        case 'Trade':
          rowData[index] = data.trade || '';
          break;
        case 'Status':
          rowData[index] = 'Pending';
          break;
        case 'Unique ID':
          rowData[index] = uniqueId;
          break;
        case 'Date of Birth':
          rowData[index] = data.dob || '';
          break;
        case 'Address':
          rowData[index] = data.address || '';
          break;
        case 'Photo':
          rowData[index] = data.photo || '';
          break;
        default:
          rowData[index] = '';
      }
    });

    console.log('📝 Appending row to district sheet...');
    districtSheet.appendRow(rowData);

    // Update capacity info
    const updatedCapacity = getTradeCapacity(data.address, data.trade);

    console.log('✅ Student registration completed successfully!');
    console.log('📊 Updated capacity:', updatedCapacity);

    return {
      success: true,
      message: 'Registration successful! Your application is pending approval.',
      studentId: uniqueId,
      timestamp: timestamp.toISOString(),
      capacity: updatedCapacity,
      district: data.address
    };

  } catch (error) {
    console.error('❌ Registration error:', error);
    return {
      success: false,
      message: 'Registration failed: ' + error.toString(),
      stack: error.stack
    };
  }
}
