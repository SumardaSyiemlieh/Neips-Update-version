// Add this function to your Google Apps Script
function getTasksByCenter(centerName) {
  try {
    console.log('🔍 getTasksByCenter called for center:', centerName);

    var sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('Tasks');
    if (!sheet) {
      return {
        success: false,
        message: 'Tasks sheet not found'
      };
    }

    var data = sheet.getDataRange().getValues();
    var headers = data[0];

    console.log('📊 Headers found in Tasks sheet:', headers);
    console.log('🔍 Looking for center:', centerName);

    // Find column indices based on your actual column names
    var centerCol = headers.indexOf('Center');
    var taskIdCol = headers.indexOf('TaskID');
    var titleCol = headers.indexOf('Title');
    var descCol = headers.indexOf('Description');
    var assignedToCol = headers.indexOf('AssignedTo');
    var assignedByCol = headers.indexOf('AssignedBy');
    var assignedDateCol = headers.indexOf('AssignedDate');
    var dueDateCol = headers.indexOf('DueDate');
    var statusCol = headers.indexOf('Status');
    var priorityCol = headers.indexOf('Priority');
    var completedDateCol = headers.indexOf('CompletedDate');
    var completionNotesCol = headers.indexOf('CompletionNotes');

    console.log('📍 Center column index:', centerCol);

    if (centerCol === -1) {
      return {
        success: false,
        message: 'Center column not found in Tasks sheet. Available columns: ' + headers.join(', ')
      };
    }

    var centerTasks = [];
    var now = new Date();

    // Start from row 1 (skip header)
    for (var i = 1; i < data.length; i++) {
      var row = data[i];
      var taskCenter = row[centerCol];

      // Check if this task belongs to the requested center
      if (taskCenter && taskCenter.toString().toLowerCase().includes(centerName.toLowerCase())) {
        var dueDate = dueDateCol !== -1 && row[dueDateCol] ? new Date(row[dueDateCol]) : null;
        var isCompleted = statusCol !== -1 && (row[statusCol] === 'Completed' || row[statusCol] === 'completed');
        var isOverdue = !isCompleted && dueDate && dueDate < now;

        var task = {
          TaskID: taskIdCol !== -1 ? row[taskIdCol] : 'T' + i.toString().padStart(4, '0'),
          Title: titleCol !== -1 ? row[titleCol] : 'No Title',
          Description: descCol !== -1 ? row[descCol] : 'No Description',
          AssignedTo: assignedToCol !== -1 ? row[assignedToCol] : '',
          AssignedBy: assignedByCol !== -1 ? row[assignedByCol] : '',
          AssignedDate: assignedDateCol !== -1 ? row[assignedDateCol] : '',
          DueDate: dueDateCol !== -1 ? row[dueDateCol] : '',
          Status: statusCol !== -1 ? row[statusCol] : 'Pending',
          Priority: priorityCol !== -1 ? row[priorityCol] : 'Medium',
          Center: taskCenter,
          // Calculate overdue information
          IsOverdue: isOverdue,
          DaysOverdue: isOverdue ? Math.ceil((now - dueDate) / (1000 * 60 * 60 * 24)) : 0
        };

        // Add completion details if available
        if (completedDateCol !== -1 && row[completedDateCol]) {
          task.CompletedDate = row[completedDateCol];
        }

        if (completionNotesCol !== -1 && row[completionNotesCol]) {
          task.CompletionNotes = row[completionNotesCol];
        }

        centerTasks.push(task);
        console.log('✅ Found task:', task.Title, 'for center:', taskCenter);
      }
    }

    console.log('📈 Total tasks found: ' + centerTasks.length + ' for center: ' + centerName);

    return {
      success: true,
      tasks: centerTasks,
      debug: {
        centerName: centerName,
        totalTasks: centerTasks.length,
        headers: headers
      }
    };

  } catch (error) {
    console.error('❌ Error in getTasksByCenter: ' + error.toString());
    return {
      success: false,
      message: 'Error: ' + error.toString(),
      stack: error.stack
    };
  }
}
